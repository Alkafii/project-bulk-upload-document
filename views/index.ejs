<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Integration Documents</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
</head>
<body class="bg-light">
    <div class="d-flex w-100" style="min-height: 100vh;">

        <%- include('./partials/sidebar.ejs') %>

        <div class="flex-fill p-5 overflow-auto">
            <div class="container-fluid px-0">
                <div class="w-100 d-flex justify-content-between align-items-center mb-4">
                    <h3 class="font-weight-bold text-primary m-0">Integration Documents</h3>
                    <div>
                        <a href="#" id="btnBulkDelete" class="btn btn-outline-danger d-none mr-1">Delete</a>
                        <a href="/upload" class="btn btn-primary">✚ Add</a>
                    </div>
                </div>

                <div class="py-2 px-0 w-100 overflow-visible">
                    <% if (typeof message !== 'undefined' && message) { %>
                    <div class="alert alert-success alert-dismissible fade show w-100 text-center mb-4 shadow-sm" role="alert">
                        <strong><%= message %></strong>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="outline: none;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <% } %>

                    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                    <div class="alert alert-danger alert-dismissible fade show w-100 text-center mb-4 shadow-sm" role="alert">
                        <strong><%= errorMessage %></strong>
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="outline: none;">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                    <% } %>

                    <div class="card border-0 shadow-sm w-100 rounded-lg overflow-hidden">
                        <div class="table-responsive">
                            <table class="table mb-0">
                                <thead class="bg-primary text-white font-weight-bold">
                                    <tr>
                                        <th class="pl-4 align-middle" style="width: 90px;">
                                            <div class="d-flex align-items-center justify-content-start">
                                                <div style="width: 32px;" class="flex-shrink: 0;"></div>
                                                <span class="pl-1">No</span>
                                            </div>
                                        </th>
                                        <th>Partner</th>
                                        <th>API Name</th>
                                        <th>Created Data</th>
                                        <th>Last Update</th>
                                        <th class="text-center">Uploaded</th>
                                        <th class="text-center">Total Size</th>
                                        <th class="text-center pr-4">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (typeof integrations === 'undefined' || !integrations.length) { %>
                                    <tr>
                                        <td colspan="8" class="p-0 bg-white">
                                            <div class="row no-gutters p-4 text-center bg-white text-muted justify-content-center">
                                                Belum ada data integrasi API.
                                            </div>
                                        </td>
                                    </tr>
                                    <% } else { %>
                                    <% integrations.forEach((item, i) => { %>
                                        <tr class="align-middle">
                                            <td class="pl-4 align-middle" style="width: 90px;">
                                                <div class="d-flex align-items-center justify-content-start">
                                                    <div style="width: 32px;" class="text-left d-flex align-items-center">
                                                        <input class="form-check-input check" type="checkbox" id="check_<%= item.id %>" value="<%= item.id %>" data-name="<%= item.name %>" style="position: static; margin: 0; flex-shrink: 0;">
                                                    </div>
                                                    <span class="font-weight-bold text-muted pl-1 align-self-cente"><%= i + 1 %></span>
                                                </div>
                                            </td>
                                            <td class="font-weight-bold"><%= item.name %></td>
                                            <td><%= item.api_name %> <%= item.va_type || '' %></td>
                                            <td>
                                                <%= item.created_at ? new Date(item.created_at).toLocaleString('id-ID') : '-' %>
                                            </td>
                                            <td>
                                                <%= item.updated_at ? new Date(item.updated_at).toLocaleString('id-ID') : '-' %>
                                            </td>
                                            <td class="text-center">
                                                <span class="badge badge-primary px-2 py-1.5">
                                                    <%= item.uploaded_count %>
                                                </span>
                                            </td>
                                            <td><%= totalSize %> MB</td>
                                            <td class="text-nowrap text-center pr-4">
                                                <a href="/read_data?id=<%= item.id %>" class="btn btn-sm btn-outline-primary mr-1">View</a>
                                            </td>
                                        </tr>
                                    <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document" style="margin-top: 25vh;">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 10px;">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold text-danger" id="deleteModalLabel">Delete Confirmation</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="outline: none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-3">
                    <p class="mb-2">Confirm to delete the following integration documents?</p>
                    <ul id="selectedItemsList" class="pl-4 font-weight-bold text-dark mb-0" style="max-height: 150px; overflow-y: auto;"></ul>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light font-weight-bold text-secondary" data-dismiss="modal">Cancel</button>
                    <a href="#" id="confirmDeleteBtn" class="btn btn-danger font-weight-bold">Delete</a>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

    <script>
        $(document).ready(function() {
            $('.form-check-input.check').on('change', function() {
                const checkedCount = $('.form-check-input.check:checked').length;
                
                if (checkedCount > 0) {
                    $('#btnBulkDelete').removeClass('d-none');
                } else {
                    $('#btnBulkDelete').addClass('d-none');
                }
            });

            $('#btnBulkDelete').on('click', function(e) {
                e.preventDefault();
                const $checkedBoxes = $('.form-check-input.check:checked');
                
                $('#selectedItemsList').empty();
                
                $checkedBoxes.each(function() {
                    const name = $(this).data('name');
                    $('#selectedItemsList').append(`<li>${name}</li>`);
                });

                const selectedIds = $checkedBoxes.map(function() {
                    return $(this).val();
                }).get().join(',');

                if (selectedIds) {
                    $('#confirmDeleteBtn').attr('href', `/delete?id=${selectedIds}`);
                    $('#deleteModal').modal('show');
                }
            });

            $('.btn-delete-trigger').on('click', function() {
                const id = $(this).data('id');
                const name = $(this).data('name');
                
                $('#selectedItemsList').empty().append(`<li>${name}</li>`);
                $('#confirmDeleteBtn').attr('href', `/delete?id=${id}`);
                $('#deleteModal').modal('show');
            });
        });
    </script>
</body>
</html>