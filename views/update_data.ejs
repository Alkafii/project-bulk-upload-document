<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <link rel="stylesheet" href="/style/style.css">
</head>
<body>
    <div class="app-layout">

        <%- include('./partials/sidebar.ejs') %>

        <main class="app-content">
            <div class="container-fluid px-0">
                <div class="d-flex justify-content mb-4">
                    <a href="/" class="text-primary font-weight-bold d-flex align-items-center" style="font-size: large;">
                        <span class="mr-1">❮</span> Back
                    </a>
                </div>

                <!-- Stepper Progress Tracker -->
                <div class="sticky-stepper-wrapper">
                <div class="stepper-container">
                    <div class="stepper-item active" id="step1">
                        <div class="step-counter">1</div>
                        <div class="step-name">Dokumen Integrasi</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="stepper-item" id="step2">
                        <div class="step-counter">2</div>
                        <div class="step-name">Verifikasi ASPI</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="stepper-item" id="step3">
                        <div class="step-counter">3</div>
                        <div class="step-name">Hasil Uji Devsite</div>
                    </div>
                    <div class="step-line"></div>
                    <div class="stepper-item" id="step4">
                        <div class="step-counter">4</div>
                        <div class="step-name">Hasil Fungsionalitas</div>
                    </div>
                </div>
            </div>


                <div class="card border-1 p-4 shadow-sm w-100" style="border-radius: 8px;">
                    <form action="/update_data?id=<%= id %>" method="post" enctype="multipart/form-data">
                        <h3 class="text-primary text-uppercase font-weight-bold mt-3 text-left">EDIT - <%= institution %></h3>
                        <p class="mb-4">Integrasi dengan Mitra <%= institution %> menggunakan API <%= integration %> <%= vaType %>, data dibuat pada <%= create_date %></p>

                        <% if (message) { %>
                            <div class="alert alert-success alert-dismissible fade show w-100 text-center mb-4 shadow-sm" role="alert">
                                <strong><%= message %></strong>
                                <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="outline: none; padding-bottom: 5px;">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                        <% } %>
                        <div id="clientErrorBox" class="alert alert-danger alert-dismissible fade show w-100 text-center mb-4 shadow-sm <%= errorMessage ? '' : 'd-none' %>" role="alert">
                            <strong id="errorMessageText"><%= errorMessage || "" %></strong>
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close" style="outline: none; padding-bottom: 5px;">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>

                        <!-- ================= LANGKAH 1: DOKUMEN INTEGRASI ================= -->
                        <div id="sectionStep1" class="form-step-section active">
                            <div class="mb-3">
                                <label>Name of institution<label class="font-weight-bold text-danger">*</label></label>
                                <input type="text" class="form-control" id="projectName" name="institutionName" placeholder="Integration with.." value="<%= institution %>" disabled>
                            </div>
                            <div class="mb-4">
                                <label>API Name<label class="font-weight-bold text-danger">*</label></label>
                                <input type="text" name="integrationType" id="integrationType" class="form-control text-secondary" value="<%= integration %>" disabled>
                            </div>  
                            <% if (integration !== "QRIS MPM SNAP") { %>
                                <div class="mb-4" id="hidden">
                                    <label>Virtual Account type<label class="font-weight-bold text-danger">*</label></label>
                                    <input type="text" name="vaType" id="vaType" class="form-control text-secondary" value="<%= vaType %>" disabled>
                                </div>
                            <% } %>

                            <h6 class="text-uppercase font-weight-bold text-primary mb-1 mt-4">📋 Dokumen Integrasi</h6>
                            <hr class="mb-3">
                            <div class="form-row mb-3">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>Form Pendaftaran API</label>
                                    <%- fields["Form_Pendaftaran_API"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>Memo Bisnis</label>
                                    <%- fields["Memo_Bisnis"] %>
                                </div>
                            </div>
                            <div class="form-row mb-3">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>BRD</label>
                                    <%- fields["BRD"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>Form Register Deployment</label>
                                    <%- fields["Form_Deployment"] %>
                                </div>
                            </div>
                            <div class="form-row mb-4">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>Outline SIT</label>
                                    <%- fields["Outline_SIT"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>BA UAT</label>
                                    <%- fields["BA_UAT"] %>
                                </div>
                            </div>
                            <hr>
                            <p class="d-flex justify-content-end mb-0">
                                <button class="btn btn-primary btn-step-nav" type="button" data-next="2" style="width: 100px;">Next</button>
                            </p>
                        </div>

                        <!-- ================= LANGKAH 2: DOKUMEN VERIFIKASI ASPI ================= -->
                        <div id="sectionStep2" class="form-step-section">
                            <h6 class="text-uppercase font-weight-bold text-primary mb-1">📁 Dokumen Verifikasi ASPI</h6>
                            <hr class="mb-3">
                            <div class="form-row mb-3">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>Memo Divisi TI</label>
                                    <%- fields["Memo_IT"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>Surat Permohonan Verifikasi</label>
                                    <%- fields["Surat_Permohonan_Verifikasi"] %>
                                </div>
                            </div>
                            <div class="form-row mb-3">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>Surat Penyataan Kebenaran dan Kesesuaian</label>
                                    <%- fields["Surat_Kebenaran"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>Surat Pernyataan Kesesuaian SOP Penyedia</label>
                                    <%- fields["Surat_Kesesuaian"] %>
                                </div>
                            </div>
                            <div class="form-row mb-4">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>Matrix Penjelasan SOP</label>
                                    <%- fields["Matriks_Penjelasan_SOP"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>SOP Penyedia Layanan</label>
                                    <%- fields["SOP_Penyedia"] %>
                                </div>
                            </div>
                            <hr>
                            <p class="d-flex justify-content-between mb-0">
                                <button class="btn btn-secondary btn-step-nav" type="button" data-prev="1" style="width: 100px;">Previous</button>
                                <button class="btn btn-primary btn-step-nav" type="button" data-next="3" style="width: 100px;">Next</button>
                            </p>
                        </div>

                        <!-- ================= LANGKAH 3: HASIL UJI DEVSITE ================= -->
                        <div id="sectionStep3" class="form-step-section">
                            <% if (typeof vaType !== "undefined" && vaType === "Off Us") { %>
                                <div>
                                    <h6 class="text-uppercase font-weight-bold text-primary mb-1">📋 Hasil Uji Developer Site VA SNAP Off Us (Pengguna Layanan)</h6>
                                    <hr class="mb-3">
                                    <div class="form-row mb-3">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Inquiry <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["24 - API Virtual Account - Inquiry - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Inquiry <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["24 - API Virtual Account - Inquiry - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-3">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Payment <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["25 - API Virtual Account - Payment - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Payment <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["25 - API Virtual Account - Payment - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-4">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Inquiry Status <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["26 - API Virtual Account - Inquiry Status - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Inquiry Status <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["26 - API Virtual Account - Inquiry Status - Negatif"] %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <% if (typeof vaType !== "undefined" && vaType === "On Us") { %>
                                <div>
                                    <h6 class="text-uppercase font-weight-bold text-primary mb-1">📋 Hasil Uji Developer Site VA SNAP On Us (Penyedia Layanan)</h6>
                                    <hr class="mb-3">
                                    <div class="form-row mb-3">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Create VA <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["27 - API Virtual Account - Create VA - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Create VA <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["27 - API Virtual Account - Create VA - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-3">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Inquiry VA <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["30 - API Virtual Account - Inquiry VA - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Inquiry VA <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["30 - API Virtual Account - Inquiry VA - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-4">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Update VA <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["28 - API Virtual Account - Update VA - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Update VA <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["28 - API Virtual Account - Update VA - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-4">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Service Payment <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["25 - API Virtual Account - Payment VA - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Service Payment <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["25 - API Virtual Account - Payment VA - Negatif"] %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <% if (typeof integration !== "undefined" && integration === "QRIS MPM SNAP") { %>
                                <div>
                                    <h6 class="text-uppercase font-weight-bold text-primary mb-1">📋 Hasil Uji Developer Site QRIS MPM SNAP (Penyedia Layanan)</h6>
                                    <hr class="mb-3">
                                    <div class="form-row mb-3">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>Generate QRIS MPM <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["47 - API Generate QR MPM - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>Generate QRIS MPM <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["47 - API Generate QR MPM - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-3">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>QRIS Check Status <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["51 - API Query Payment - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>QRIS Check Status <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["51 - API Query Payment - Negatif"] %>
                                        </div>
                                    </div>
                                    <div class="form-row mb-4">
                                        <div class="form-group col-md-6 mb-0 pr-3">
                                            <label>QRIS Callback <label class="font-weight-bold text-success">(Positif)</label></label>
                                            <%- fields["52 - API Payment Notification - Positif"] %>
                                        </div>
                                        <div class="form-group col-md-6 mb-0 pl-3">
                                            <label>QRIS Callback <label class="font-weight-bold text-danger">(Negatif)</label></label>
                                            <%- fields["52 - API Payment Notification - Negatif"] %>
                                        </div>
                                    </div>
                                </div>
                            <% } %>
                            <hr>
                            <p class="d-flex justify-content-between mb-0">
                                <button class="btn btn-secondary btn-step-nav" type="button" data-prev="2" style="width: 100px;">Previous</button>
                                <button class="btn btn-primary btn-step-nav" type="button" data-next="4" style="width: 100px;">Next</button>
                            </p>
                        </div>

                        <!-- ================= LANGKAH 4: HASIL FUNGSIONALITAS ================= -->
                        <div id="sectionStep4" class="form-step-section">
                            <h6 class="text-uppercase font-weight-bold text-primary mb-1">🗃️ Hasil Uji Fungsionalitas</h6>
                            <hr class="mb-3">
                            <div class="form-row mb-3">
                                <div class="form-group col-md-6 mb-0 pr-3">
                                    <label>BA Uji Fungsionalitas</label>
                                    <%- fields["BA_Uji_Fungsi"] %>
                                </div>
                                <div class="form-group col-md-6 mb-0 pl-3">
                                    <label>Hasil Uji Fungsionalitas</label>
                                    <%- fields["Hasil_Uji_Fungsi"] %>
                                </div>
                            </div>
                            <hr>
                            <div class="row no-gutters mb-3">
                                <div class="col-12 d-flex justify-content-between">
                                    <button class="btn btn-secondary btn-step-nav" type="button" data-prev="3" style="width: 100px;">Previous</button>
                                    <button type="submit" class="btn btn-primary" style="width: 120px;">Update</button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Konfirmasi Delete Berkas -->
    <div class="modal fade" id="modalDeleteConfirmation" tabindex="-1" role="dialog" aria-labelledby="labelDeleteConfirmation" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="labelDeleteConfirmation">Confirm to delete this document</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete the integration document "<strong id="nama-berkas-modal"></strong>"?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <a id="btn-delete-confirmation" href="#" class="btn btn-danger">Delete</a>
            </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
    
    <script>
        $(document).ready(function () {
            const errorBox = $('#clientErrorBox');
            const errorText = $('#errorMessageText');

            const MAX_MB = Number("<%= typeof maxMB !== 'undefined' ? maxMB : 10 %>") || 10;
            const MAX_FILE_SIZE = Number("<%= typeof maxFileSize !== 'undefined' ? maxFileSize : 10485760 %>") || 10485760;
            const allowedExtensions = ['pdf', 'doc', 'docx', 'xls', 'xlsx'];

            function toggleError(message = '') {
                errorText.text(message);
                errorBox.toggleClass('d-none', !message).toggleClass('show', !!message);
                if (message) window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function validateFile(file) {
                const ext = file.name.split('.').pop().toLowerCase();
                if (!allowedExtensions.includes(ext)) return 'Format file tidak didukung! Gunakan PDF, DOC, DOCX, XLS, atau XLSX.';
                if (file.size > MAX_FILE_SIZE) return `Ukuran file terlalu besar! Ukuran maksimal adalah ${MAX_MB} MB.`;
                return null;
            }

            function processFiles(input) {
                const files = Array.from(input.files);
                if (!files.length) return;

                for (const file of files) {
                    const error = validateFile(file);
                    if (error) {
                        input.value = '';
                        $(input).next('.custom-file-label').removeClass('selected').text('Choose file');
                        return toggleError(error);
                    }
                }

                $(input)
                    .next('.custom-file-label')
                    .addClass('selected')
                    .text(files[0].name);

                toggleError();
            }

            $(document).on('change', '.custom-file-input', function () {
                processFiles(this);
            });

            $('.btn-step-nav').on('click', function () {
                const nextStep = $(this).data('next');
                const prevStep = $(this).data('prev');
                let targetStep = nextStep || prevStep;

                if (nextStep) {
                    const currentSection = $(this).closest('.form-step-section');
                    let isValid = true;
                    
                    currentSection.find('input[required], select[required]').each(function() {
                        if (!this.checkValidity()) {
                            this.reportValidity();
                            isValid = false;
                            return false;
                        }
                    });
                    if (!isValid) return; 
                }

                $('.form-step-section').removeClass('active');
                $(`#sectionStep${targetStep}`).addClass('active');

                updateStepperUI(targetStep);

                setTimeout(() => {
                    const stepperWrapper = document.querySelector('.sticky-stepper-wrapper');
                    if (stepperWrapper) {
                        stepperWrapper.setAttribute('tabindex', '-1'); 
                        stepperWrapper.focus({ preventScroll: false }); // Paksa pandangan melompat ke elemen ini
                        stepperWrapper.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    }

                    const scrollableContainers = ['.app-content', '.app-layout', 'main', 'body', 'html'];
                    scrollableContainers.forEach(selector => {
                        const el = document.querySelector(selector);
                        if (el) el.scrollTop = 0;
                    });
                }, 50);
            });

            function updateStepperUI(activeStep) {
                for (let i = 1; i <= 4; i++) {
                    const stepItem = $(`#step${i}`);
                    if (i < activeStep) {
                        stepItem.removeClass('active').addClass('completed');
                        stepItem.find('.step-counter').html('✓');
                    } else if (i === activeStep) {
                        stepItem.removeClass('completed').addClass('active');
                        stepItem.find('.step-counter').text(i);
                    } else {
                        stepItem.removeClass('completed active');
                        stepItem.find('.step-counter').text(i);
                    }
                }
            }

            // PERBAIKAN EVENT DELEGATION: Menggunakan delegasi tingkat dokumen agar tombol delete dari backend tetap merespons modal
            $(document).on("click", "[data-toggle='modal'][data-target='#modalDeleteConfirmation']", function (e) {
                e.preventDefault();
                const button = $(this);
                const id = button.data("id") || button.attr("data-id");
                const fileName = button.data("filename") || button.attr("data-filename");

                $("#nama-berkas-modal").text(fileName);
                const deleteUrl = `/delete_file?id=${encodeURIComponent(id)}&fileName=${encodeURIComponent(fileName)}`;
                $("#btn-delete-confirmation").attr("href", deleteUrl);
            });

            // Logika kontrol input dinamis Step 3 berdasarkan tipe API dari Step 1
            window.toggleApiFields = function (selectedValue) {
                const isVA = selectedValue === 'Virtual Account SNAP';
                
                $('#VA').toggle(isVA);
                $('#vaType').prop('required', isVA);

                adjustStep3Fields();
            };

            $('#vaType').on('change', function() {
                adjustStep3Fields();
            });

            function adjustStep3Fields() {
                const apiType = $('#integrationType').val();
                const vaType = $('#vaType').val();

                $('#devsiteVAOff, #devsiteVAOn, #devsiteQRIS, #noApiSelectedMessage').hide();
                $('#btnNextToStep4').prop('disabled', false);

                if (apiType === 'Virtual Account SNAP') {
                    if (vaType === 'Off Us') {
                        $('#devsiteVAOff').show();
                    } else if (vaType === 'On Us') {
                        $('#devsiteVAOn').show();
                    } else {
                        $('#noApiSelectedMessage').show();
                        $('#btnNextToStep4').prop('disabled', true);
                    }
                } else if (apiType === 'QRIS MPM SNAP') {
                    $('#devsiteQRIS').show();
                } else {
                    $('#noApiSelectedMessage').show();
                    $('#btnNextToStep4').prop('disabled', true);
                }
            }

            $('form').on('submit', function (e) {
                const files = $('.custom-file-input')
                    .toArray()
                    .flatMap((i) => Array.from(i.files));

                for (const file of files) {
                    const error = validateFile(file);
                    if (error) {
                        e.preventDefault();
                        return toggleError(error);
                    }
                }
            });

            $('.custom-file-input').attr('accept', '.pdf,.doc,.docx,.xls,.xlsx');
        });

        const wrapper = document.querySelector('.sticky-stepper-wrapper');
        const container = document.querySelector('.stepper-container');
        if (wrapper && container) {
            const observer = new IntersectionObserver(
                ([entry]) => {
                    container.classList.toggle('is-sticky', entry.intersectionRatio < 1);
                },
                { threshold: 1, rootMargin: '-1px 0px 0px 0px' }
            );
            observer.observe(wrapper);
        }
    </script>
</body>
</html>
