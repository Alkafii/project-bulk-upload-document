<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Integration Documents</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <style>
        .upload-page {
            min-height: 100vh;
        }

        .upload-container {
            max-width: 1050px;
            width: 100%;
        }

        .dropzone {
            border: 2px dashed #9bb8df;
            border-radius: 12px;
            background: #f7faff;
            padding: 32px;
            text-align: center;
            cursor: pointer;
            transition: background-color .2s ease, border-color .2s ease;
        }

        .dropzone:hover,
        .dropzone.drag {
            background: #eaf2ff;
            border-color: #2563eb;
        }

        .dropzone:focus {
            outline: 3px solid rgba(37, 99, 235, .2);
            outline-offset: 2px;
        }

        .doc-row {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 14px;
            margin-bottom: 10px;
            background: #fff;
        }

        .upload-container {
            max-width: 100%;
        }

        @media (max-width: 768px) {
            .upload-page main {
                padding: 16px !important;
            }

            .upload-container {
                padding-left: 0;
                padding-right: 0;
            }
        }

        @media (max-width: 576px) {
            .upload-card-body {
                padding: 16px !important;
            }

            .dropzone {
                padding: 24px 14px;
            }

            .doc-row {
                padding: 12px;
            }

            .upload-actions {
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex upload-page">

        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4 w-100">
            <div class="container-fluid upload-container">
                <div class="sticky-top bg-light py-3 px-2 mb-2" style="z-index: 1020;">
                    <a href="/read_data?id=<%= integration.id %>" class="font-weight-bold">‹ Back</a>
                    <h3 class="text-primary font-weight-bold mt-3 mb-4">Edit Integration Documents</h3>
                </div>

                <%- include('./partials/alerts.ejs') %>

                <form id="editForm" action="/update_data?id=<%= integration.id %>" method="POST" enctype="multipart/form-data">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4 upload-card-body">
                            <div class="form-row">
                                <div class="form-group col-md-6"> <label>Partner Name</label> <input class="form-control" name="institutionName" maxlength="256" value="<%= integration.name %>" required> </div>
                                <div class="form-group col-md-6"> <label>API Name</label> <input class="form-control" name="integrationType" maxlength="128" value="<%= integration.api_name %>" required> </div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0">
                            Current Documents (<%= totalDocuments %>)
                        </div>
                        <div class="card-body p-4 upload-card-body">

                            <div id="mainDocListContainer">
                                <%- documentsHTML %>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4 flex-wrap">
                                <nav>
                                    <ul class="pagination pagination-sm mb-0" id="mainPaginationControls"></ul>
                                </nav>

                                <button
                                    type="button"
                                    id="updateBtn"
                                    class="btn btn-primary d-none mt-2 mt-md-0">
                                    Update
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <h5 class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0 mb-1">Document List</h5>
                        <div class="card-body px-4 pb-4 pt-0 upload-card-body">
                            
                            <%- include('./partials/dropzone.ejs', {
                                dropzoneId: 'dropzone',
                                inputId: 'newInput'
                            }) %>

                            <div id="newList" class="mt-4"></div>
                            <%- include('./partials/document_list_item.ejs') %>
                            
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 upload-actions">
                        <button
                            type="button"
                            id="saveBtn"
                            class="btn btn-primary d-none">
                            Upload
                        </button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <%- include('./partials/modal_confirm_delete.ejs', {
        modalId: 'deleteDocumentsModal',
        modalTitle: 'Delete Document Confirmation',
        modalMessage: 'Are you sure you want to delete the following documents?',
        listId: 'deleteDocumentsList',
        confirmId: 'confirmDeleteDocumentsBtn',
        confirmLabel: 'Delete'
    }) %>

    <%- include('./partials/modal_review_documents.ejs') %>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

    <script>
        (() => {
            "use strict";

            const form = document.getElementById('editForm');
            const input = document.getElementById('newInput');

            const drop = document.getElementById('dropzone');
            const list = document.getElementById('newList');
            const documentTemplate = document.getElementById("documentListItemTemplate");

            const save = document.getElementById('saveBtn');
            const update = document.getElementById('updateBtn');

            const institutionInput = form.querySelector('[name="institutionName"]');
            const integrationInput = form.querySelector('[name="integrationType"]');

            const originalInstitution = institutionInput.value.trim();
            const originalIntegration = integrationInput.value.trim();

            const maxFile = Number('<%= maxMB * 1024 * 1024 %>'), maxTotal = Number('<%= maxTotalMB * 1024 * 1024 %>'), maxFiles = Number('<%= maxFiles %>');
            const allowed = ['pdf', 'doc', 'docx', 'xls', 'xlsx'];
            let added = [];
            let currentMainPage = 1;
            let currentReviewPage = 1;
            let currentReplacements = [];

            const mainItemsPerPage = 10;
            const reviewItemsPerPage = 10;

            const $docItems = $(".main-doc-item");

            const fmt = n => (n / 1024 / 1024).toFixed(2) + ' MB';
            const nameOf = f => f.name.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();
            const getAddedTotalSize = () => added.reduce((sum, item) => sum + item.file.size, 0);

            function updateActionButtons() {
                const selectedDeletes = document.querySelectorAll(
                    ".delete-doc:checked"
                );

                const selectedReplacements = Array.from(
                    document.querySelectorAll(".replacement-file")
                ).filter(function(fileInput) {
                    return fileInput.files.length > 0;
                });

                const partnerChanged =
                    institutionInput.value.trim() !== originalInstitution;

                const apiChanged =
                    integrationInput.value.trim() !== originalIntegration;

                const hasUpdateChanges =
                    selectedDeletes.length > 0 ||
                    selectedReplacements.length > 0 ||
                    partnerChanged ||
                    apiChanged;

                if (hasUpdateChanges) {
                    update.classList.remove("d-none");
                } else {
                    update.classList.add("d-none");
                }

                if (added.length > 0) {
                    save.classList.remove("d-none");
                } else {
                    save.classList.add("d-none");
                }
            }

            function render() {
                list.innerHTML = "";

                added.forEach(function(item, index) {
                    const row = documentTemplate.content.cloneNode(true);

                    const label = row.querySelector("[data-document-label]");
                    const nameInput = row.querySelector("[data-document-name]");
                    const fileInfo = row.querySelector("[data-file-info]");
                    const removeButton = row.querySelector("[data-remove-document]");

                    label.textContent = "Document Name #" + (index + 1);

                    nameInput.value = item.name;

                    fileInfo.textContent =
                        item.file.name + " · " +
                        (item.file.size < 1048576
                            ? (item.file.size / 1024).toFixed(1) + " KB"
                            : (item.file.size / 1048576).toFixed(2) + " MB");

                    nameInput.addEventListener("input", function() {
                        item.name = this.value;
                    });

                    removeButton.addEventListener("click", function() {
                        added.splice(index, 1);
                        render();
                    });

                    list.appendChild(row);
                });

                updateActionButtons();
            }

            function addFiles(files) {
                for (const file of Array.from(files || [])) {
                    const ext = file.name.split('.').pop().toLowerCase();
                    if (!allowed.includes(ext)) { alert('Format file tidak didukung: ' + file.name); continue; }
                    if (file.size > maxFile) { alert('Ukuran file terlalu besar: ' + file.name); continue; }
                    if (added.length >= maxFiles) { alert('Maksimal ' + maxFiles + ' file.'); break; }
                    if (getAddedTotalSize() + file.size > maxTotal) { alert('Total ukuran file melebihi batas.'); break; }

                    added.push({ file, name: nameOf(file) });
                }
                input.value = ''; render();
            }

            drop.addEventListener('click', () => input.click());
            input.addEventListener('change', () => addFiles(input.files));
            ['dragover', 'dragenter', 'dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.toggle('drag', ev.includes('er')); if (ev === 'drop') addFiles(e.dataTransfer.files); }));

            $(form).on("change", ".delete-doc", function() {
                updateActionButtons();
            });

            $(form).on("change", ".replacement-file", function() {
                const hidden = this.parentElement.querySelector('input[type="hidden"]');

                if (hidden) {
                    hidden.disabled = !this.files.length;
                }

                const label = this.parentElement.querySelector('.custom-file-label');

                if (label) {
                    if (this.files.length > 0) {
                        label.textContent = this.files[0].name;
                    } else {
                        label.textContent = "Choose file or drag here...";
                    }
                }

                updateActionButtons();
            });

            institutionInput.addEventListener("input", updateActionButtons);
            integrationInput.addEventListener("input", updateActionButtons);

            let currentDeleteIds = [];

            function submitUpdateData(action) {
                const data = new FormData(form);

                data.delete("newDocuments");
                data.delete("newDocumentNames");
                data.delete("replacementDocumentIds");

                if (action === "update") {

                    data.delete("newDocuments");
                    data.delete("newDocumentNames");

                    for (const fileInput of currentReplacements) {
                        data.append(
                            "replacementDocumentIds",
                            fileInput.dataset.id
                        );
                    }

                    update.disabled = true;
                    update.textContent = "Updating...";

                } else if (action === "save") {
                    data.delete("deleteDocumentIds");
                    data.delete("replacementFiles");
                    data.delete("replacementDocumentIds");

                    data.set("institutionName", originalInstitution);
                    data.set("integrationType", originalIntegration);

                    for (const item of added) {
                        data.append(
                            "newDocuments",
                            item.file,
                            item.file.name
                        );

                        data.append(
                            "newDocumentNames",
                            item.name.trim()
                        );
                    }

                    save.disabled = true;
                    save.textContent = "Saving...";
                }

                fetch(form.action, {
                    method: "POST",
                    body: data,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(async function(response) {
                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(
                            result.message || "Gagal menyimpan perubahan."
                        );
                    }

                    if (result.success && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                        return;
                    }

                    throw new Error("Respons server tidak valid.");
                })
                .catch(function(error) {
                    alert(error.message);

                    update.disabled = false;
                    update.textContent = "Update";

                    save.disabled = false;
                    save.textContent = "Save";
                });
            }

            function showReviewModal() {
                currentReviewPage = 1;
                $("#reviewPartner").text(
                    form.querySelector('[name="institutionName"]').value.trim()
                );

                $("#reviewApi").text(
                    form.querySelector('[name="integrationType"]').value.trim()
                );

                renderModalDocuments();
                $("#reviewModal").modal("show");
            }

            let currentAction = "";

            form.addEventListener("submit", function(event) {
                event.preventDefault();
            });

            function startUpdate() {

                const replacements = Array.from(
                    document.querySelectorAll(".replacement-file")
                ).filter(function(fileInput) {
                    return fileInput.files.length > 0;
                });

                const deletes = Array.from(
                    document.querySelectorAll(".delete-doc:checked")
                );

                const deleteIds = deletes.map(function(item) {
                    return item.value;
                });

                if (replacements.some(function(fileInput) {
                    return deleteIds.includes(fileInput.dataset.id);
                })) {
                    alert("Dokumen yang sama tidak bisa dihapus dan diganti sekaligus.");
                    return;
                }

                if (replacements.length > maxFiles) {
                    alert("Maksimal " + maxFiles + " file pengganti.");
                    return;
                }

                const replacementSize = replacements.reduce(
                    function(total, fileInput) {
                        return total + fileInput.files[0].size;
                    },
                    0
                );

                if (replacementSize > maxTotal) {
                    alert("Total ukuran file pengganti melebihi batas.");
                    return;
                }

                if (replacements.some(function(fileInput) {
                    return fileInput.files[0].size > maxFile;
                })) {
                    alert("Ukuran salah satu file pengganti melebihi batas.");
                    return;
                }

                currentAction = "update";
                currentReplacements = replacements;

                if (deletes.length > 0) {

                    const deleteList = $("#deleteDocumentsList").empty();

                    for (const checkbox of deletes) {

                        const docRow = checkbox.closest(".main-doc-item");
                        const nameElement = docRow.querySelector(".document-name");

                        let docName = "Nama dokumen tidak ditemukan";

                        if (nameElement) {
                            docName = nameElement.textContent.trim();
                        }

                        $("<li>")
                            .text(docName)
                            .appendTo(deleteList);
                    }

                    $("#deleteDocumentsModal").modal("show");
                    return;
                }

                if (replacements.length > 0) {
                    showReviewModal();
                    return;
                }

                submitUpdateData("update");
            }

            function startSave() {

                if (added.length === 0) {
                    return;
                }

                if (added.some(function(item) {
                    return !item.name.trim();
                })) {
                    alert("Nama dokumen baru tidak boleh kosong.");
                    return;
                }

                if (added.length > maxFiles) {
                    alert("Maksimal " + maxFiles + " dokumen baru.");
                    return;
                }

                if (getAddedTotalSize() > maxTotal) {
                    alert("Total ukuran dokumen baru melebihi batas.");
                    return;
                }

                currentAction = "save";
                currentReplacements = [];

                showReviewModal();
            }

            update.addEventListener("click", function() {
                startUpdate();
            });

            save.addEventListener("click", function() {
                startSave();
            });

            $("#confirmDeleteDocumentsBtn").on("click", function(event) {

                event.preventDefault();

                $("#deleteDocumentsModal").modal("hide");

                if (currentAction === "update" && currentReplacements.length > 0) {
                    showReviewModal();
                    return;
                }

                submitUpdateData("update");
            });

            $("#confirmSubmitBtn").on("click", function() {

                $("#reviewModal").modal("hide");

                submitUpdateData(currentAction);
            });

            function renderMainPagePagination() {
                const totalMainItems = $docItems.length, totalPages = Math.ceil(totalMainItems / mainItemsPerPage), $controls = $('#mainPaginationControls').empty();
                if (totalMainItems === 0) return;

                $docItems.hide().slice((currentMainPage - 1) * mainItemsPerPage, currentMainPage * mainItemsPerPage).show();

                if (totalPages > 1) {
                    const createPageBtn = (label, targetPage, disabled, active) => {
                        return $(`<li class="page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}"><a class="page-link" href="#">${label}</a></li>`)
                            .on('click', e => { e.preventDefault(); if (!disabled) { currentMainPage = targetPage; renderMainPagePagination(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
                    };
                    $controls.append(createPageBtn('&laquo;', currentMainPage - 1, currentMainPage === 1));
                    for (let i = 1; i <= totalPages; i++) $controls.append(createPageBtn(i, i, false, currentMainPage === i));
                    $controls.append(createPageBtn('&raquo;', currentMainPage + 1, currentMainPage === totalPages));
                }
            }

            renderMainPagePagination();

            updateActionButtons();

            function renderModalDocuments() {
                const reviewDocList = $("#reviewDocList");
                const paginationControls = $("#reviewPaginationControls");

                reviewDocList.empty();
                paginationControls.empty();

                let reviewDocuments = [];
                let totalSize = 0;

                if (currentAction === "save") {
                    for (const item of added) {
                        reviewDocuments.push({
                            name: item.name,
                            fileName: item.file.name,
                            size: item.file.size,
                            type: "Dokumen Baru"
                        });

                        totalSize += item.file.size;
                    }

                }

                if (currentAction === "update") {
                    for (const fileInput of currentReplacements) {
                        if (fileInput.files.length > 0) {
                            const file = fileInput.files[0];
                            const docRow = fileInput.closest(".main-doc-item");

                            let documentName = "Dokumen";

                            if (docRow) {
                                const nameElement = docRow.querySelector(".document-name");

                                if (nameElement) {
                                    documentName = nameElement.textContent.trim();
                                }
                            }

                            reviewDocuments.push({
                                name: documentName,
                                fileName: file.name,
                                size: file.size,
                                type: "Penggantian Dokumen"
                            });

                            totalSize += file.size;
                        }
                    }
                }

                $("#reviewDocCount").text(reviewDocuments.length);
                $("#reviewSize").text(fmt(totalSize));

                if (reviewDocuments.length === 0) {
                    const emptyItem = $("<li>")
                        .addClass("text-center text-muted p-4")
                        .text("Tidak ada dokumen untuk diproses.");

                    reviewDocList.append(emptyItem);
                    $("#reviewPageInfo").text("");
                    $("#reviewPaginationContainer").hide();

                    return;
                }

                const totalPages = Math.ceil(
                    reviewDocuments.length / reviewItemsPerPage
                );

                if (currentReviewPage > totalPages) {
                    currentReviewPage = totalPages;
                }

                if (currentReviewPage < 1) {
                    currentReviewPage = 1;
                }

                const startIndex = (currentReviewPage - 1) * reviewItemsPerPage;
                const endIndex = startIndex + reviewItemsPerPage;

                const visibleDocuments = reviewDocuments.slice(startIndex, endIndex);

                $("#reviewPageInfo").text(
                    "Menampilkan " +
                    (startIndex + 1) +
                    "-" +
                    Math.min(endIndex, reviewDocuments.length) +
                    " dari " +
                    reviewDocuments.length +
                    " dokumen"
                );

                for (let i = 0; i < visibleDocuments.length; i++) {
                    const documentData = visibleDocuments[i];
                    const documentNumber = startIndex + i + 1;

                    const listItem = $("<li>").addClass("review-item");

                    const number = $("<div>")
                        .addClass("review-number")
                        .text(documentNumber);

                    const content = $("<div>")
                        .addClass("flex-fill");

                    const documentName = $("<div>")
                        .addClass("review-document-name")
                        .text(documentData.name);

                    const fileName = $("<div>")
                        .addClass("review-file-name")
                        .text(documentData.fileName);

                    const metadata = $("<div>")
                        .addClass("review-item-meta")
                        .text(fmt(documentData.size));

                    const type = $("<span>")
                        .addClass("review-type");

                    if (documentData.type === "Penggantian Dokumen") {
                        type.addClass("replacement");
                    }

                    type.text(documentData.type);

                    content.append(documentName);
                    content.append(fileName);
                    content.append(metadata);

                    const rightContent = $("<div>")
                        .addClass("ml-3 text-right");

                    rightContent.append(type);

                    listItem.append(number);
                    listItem.append(content);
                    listItem.append(rightContent);

                    reviewDocList.append(listItem);
                }

                if (totalPages <= 1) {
                    $("#reviewPaginationContainer").hide();
                    return;
                }

                $("#reviewPaginationContainer").show();

                const previousItem = $("<li>")
                    .addClass("page-item");

                const previousButton = $("<a>")
                    .addClass("page-link")
                    .attr("href", "#")
                    .text("Previous");

                if (currentReviewPage === 1) {
                    previousItem.addClass("disabled");
                }

                previousButton.on("click", function (event) {
                    event.preventDefault();

                    if (currentReviewPage > 1) {
                        currentReviewPage--;
                        renderModalDocuments();
                    }
                });

                previousItem.append(previousButton);
                paginationControls.append(previousItem);

                for (let page = 1; page <= totalPages; page++) {
                    const pageItem = $("<li>")
                        .addClass("page-item");

                    const pageButton = $("<a>")
                        .addClass("page-link")
                        .attr("href", "#")
                        .text(page);

                    if (page === currentReviewPage) {
                        pageItem.addClass("active");
                    }

                    pageButton.on("click", function (event) {
                        event.preventDefault();

                        currentReviewPage = page;
                        renderModalDocuments();
                    });

                    pageItem.append(pageButton);
                    paginationControls.append(pageItem);
                }

                const nextItem = $("<li>")
                    .addClass("page-item");

                const nextButton = $("<a>")
                    .addClass("page-link")
                    .attr("href", "#")
                    .text("Next");

                if (currentReviewPage === totalPages) {
                    nextItem.addClass("disabled");
                }

                nextButton.on("click", function (event) {
                    event.preventDefault();

                    if (currentReviewPage < totalPages) {
                        currentReviewPage++;
                        renderModalDocuments();
                    }
                });

                nextItem.append(nextButton);
                paginationControls.append(nextItem);
            }
        })();
    </script>
    
</body>
</html>
