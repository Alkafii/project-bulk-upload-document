<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Integration</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">

    <style>
        .upload-page {
            min-height: 100vh;
        }

        .upload-container {
            max-width: 1050px;
            width: 100%;
        }

        .dropzone {
            border: 2px dashed #9bb8df;
            border-radius: 12px;
            background: #f7faff;
            padding: 32px;
            text-align: center;
            cursor: pointer;
            transition: background-color .2s ease, border-color .2s ease;
        }

        .dropzone:hover,
        .dropzone.drag {
            background: #eaf2ff;
            border-color: #2563eb;
        }

        .dropzone:focus {
            outline: 3px solid rgba(37, 99, 235, .2);
            outline-offset: 2px;
        }

        .doc-row {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 14px;
            margin-bottom: 10px;
            background: #fff;
        }

        .upload-container {
            max-width: 100%;
        }

        @media (max-width: 768px) {
            .upload-page main {
                padding: 16px !important;
            }

            .upload-container {
                padding-left: 0;
                padding-right: 0;
            }
        }

        @media (max-width: 576px) {
            .upload-card-body {
                padding: 16px !important;
            }

            .dropzone {
                padding: 24px 14px;
            }

            .doc-row {
                padding: 12px;
            }

            .upload-actions {
                flex-wrap: wrap;
            }
        }
    </style>
</head>

<body class="bg-light">
    <div class="d-flex upload-page">
        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4 w-100">
            <div class="container-fluid upload-container">
                <a href="/read_data?id=<%= integration.id %>" class="font-weight-bold"> ‹ Back </a>
                <h3 class="text-primary font-weight-bold mt-3 mb-4"> Edit Integration </h3>

                <% if (typeof message !== "undefined" && message) { %>
                    <div class="alert alert-success"><%= message %></div>
                <% } %>

                <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
                    <div class="alert alert-danger"><%= errorMessage %></div>
                <% } %>

                <form id="editForm" action="/update_data?id=<%= integration.id %>" method="POST" enctype="multipart/form-data">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4 upload-card-body">
                            <div class="form-row">
                                <div class="form-group col-md-6"> <label>Partner Name</label> <input class="form-control" name="institutionName" maxlength="256" value="<%= integration.name %>" required> </div>
                                <div class="form-group col-md-6"> <label>API Name</label> <input class="form-control" name="integrationType" maxlength="128" value="<%= integration.api_name %>" required> </div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0">Current Documents</div>
                        <div class="card-body p-4 upload-card-body">

                            <% if (!documents.length) { %>
                                <p class="text-muted text-center py-4">Belum ada dokumen.</p>
                            <% } %>

                            <% documents.forEach(doc => { %>
                                <div class="doc-row">
                                    <div class="d-block">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div class="pr-3">
                                                <div class="font-weight-bold" style="font-size: 16px;">
                                                    <%= doc.document_name %>
                                                </div>
                                                <div class="small text-muted mb-1">
                                                    <%= doc.original_filename %>
                                                    ·
                                                    <%= (Number(doc.file_size) / 1024 / 1024).toFixed(2) %> MB
                                                </div>
                                                <a class="small font-weight-bold" href="/view_file?documentId=<%= doc.id %>" target="_blank">View Document</a>
                                            </div>
                                            <label class="text-danger small mb-0 font-weight-bold d-flex align-items-center" style="cursor: pointer; user-select: none; flex-shrink: 0;">
                                                <input type="checkbox" name="deleteDocumentIds" value="<%= doc.id %>" class="delete-doc mr-1" style="cursor: pointer;">Delete
                                            </label>
                                        </div>
                                        <div class="mt-3 w-100">
                                            <label class="small font-weight-bold mb-2 text-dark">Replace (optional)</label>
                                            <div class="custom-file w-100" style="cursor: pointer;">
                                                <input 
                                                    type="file" 
                                                    class="custom-file-input replacement-file" 
                                                    id="replace_<%= doc.id %>"
                                                    name="replacementFiles" 
                                                    data-id="<%= doc.id %>" 
                                                    accept=".pdf,.doc,.docx,.xls,.xlsx"
                                                    style="cursor: pointer;">
                                                <label class="custom-file-label small text-muted" for="replace_<%= doc.id %>" style="border-color: #ced4da; background-color: #fff;">
                                                    Choose file or drag here...
                                                </label>
                                            </div>  
                                            <input type="hidden" name="replacementDocumentIds" value="<%= doc.id %>" disabled>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>

                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <h5 class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0 mb-1">Document List</h5>
                        <div class="card-body px-4 pb-4 pt-0 upload-card-body">
                            
                            <%- include('./partials/dropzone.ejs', {
                                dropzoneId: 'dropzone',
                                inputId: 'newInput'
                            }) %>

                            <div id="newList" class="mt-4"></div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 upload-actions">
                        <a href="/read_data?id=<%= integration.id %>" class="btn btn-light mr-2"> Batal </a>
                        <button type="submit" class="btn btn-primary">Simpan</button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

    <script>
        (() => {
            const form = document.getElementById('editForm');
            const input = document.getElementById('newInput');
            const drop = document.getElementById('dropzone');
            const list = document.getElementById('newList');
            const save = document.getElementById('saveBtn');

            const maxFile = Number('<%= maxMB * 1024 * 1024 %>');
            const maxTotal = Number('<%= maxTotalMB * 1024 * 1024 %>');
            const maxFiles = Number('<%= maxFiles %>');


            const allowed = ['pdf', 'doc', 'docx', 'xls', 'xlsx'];
            let added = [];

            const fmt = n => (n / 1024 / 1024).toFixed(2) + ' MB';

            function nameOf(file) {
                return file.name
                    .replace(/\.[^.]+$/, '')
                    .replace(/[_-]+/g, ' ')
                    .trim();
            }

            function render() {
                list.innerHTML = '';

                added.forEach((item, index) => {
                    const row = document.createElement('div');
                    row.className = 'doc-row';

                    row.innerHTML =
                        '<label class="small font-weight-bold">Nama dokumen</label>' +
                        '<div class="d-flex">' +
                        '<input class="form-control form-control-sm mr-2" maxlength="255">' +
                        '<button type="button" class="btn btn-sm btn-outline-danger">Hapus</button>' +
                        '</div>' +
                        '<div class="small text-muted mt-1"></div>';

                    const nameInput = row.querySelector('input');

                    nameInput.value = item.name;

                    nameInput.addEventListener('input', event => {
                        item.name = event.target.value;
                    });

                    row.querySelector('.small.text-muted').textContent =
                        item.file.name + ' · ' + fmt(item.file.size);

                    row.querySelector('button').addEventListener('click', () => {
                        added.splice(index, 1);
                        render();
                    });

                    list.appendChild(row);
                });
            }

            function addFiles(files) {
                for (const file of Array.from(files || [])) {
                    const ext = file.name.split('.').pop().toLowerCase();

                    if (!allowed.includes(ext)) {
                        alert('Format file tidak didukung: ' + file.name);
                        continue;
                    }

                    if (file.size > maxFile) {
                        alert('Ukuran file terlalu besar: ' + file.name);
                        continue;
                    }

                    if (added.length >= maxFiles) {
                        alert('Maksimal ' + maxFiles + ' file.');
                        break;
                    }

                    const currentTotal = added.reduce(
                        (sum, item) => sum + item.file.size,
                        0
                    );

                    if (currentTotal + file.size > maxTotal) {
                        alert('Total ukuran file melebihi batas.');
                        break;
                    }

                    added.push({
                        file,
                        name: nameOf(file)
                    });
                }

                input.value = '';
                render();
            }

            drop.addEventListener('click', () => input.click());

            input.addEventListener('change', () => {
                addFiles(input.files);
            });

            ['dragover', 'dragenter'].forEach(eventName => {
                drop.addEventListener(eventName, event => {
                    event.preventDefault();
                    drop.classList.add('drag');
                });
            });

            ['dragleave', 'drop'].forEach(eventName => {
                drop.addEventListener(eventName, event => {
                    event.preventDefault();
                    drop.classList.remove('drag');
                });
            });

            drop.addEventListener('drop', event => {
                addFiles(event.dataTransfer.files);
            });

            document.querySelectorAll('.replacement-file').forEach(inputFile => {
                const hidden = inputFile.parentElement.querySelector(
                    'input[type="hidden"]'
                );

                inputFile.addEventListener('change', () => {
                    hidden.disabled = !inputFile.files.length;
                });
            });

            form.addEventListener('submit', event => {
                const replacements = Array.from(
                    document.querySelectorAll('.replacement-file')
                ).filter(inputFile => inputFile.files.length);

                const deletes = Array.from(
                    document.querySelectorAll('.delete-doc:checked')
                ).map(checkbox => checkbox.value);

                if (replacements.some(file => deletes.includes(file.dataset.id))) {
                    event.preventDefault();
                    alert('Dokumen yang sama tidak bisa dihapus dan diganti sekaligus.');
                    return;
                }

                if (replacements.length + added.length > maxFiles) {
                    event.preventDefault();
                    alert('Maksimal ' + maxFiles + ' file perubahan per proses.');
                    return;
                }

                if (added.some(item => !item.name.trim())) {
                    event.preventDefault();
                    alert('Nama dokumen baru tidak boleh kosong.');
                    return;
                }

                const total =
                    added.reduce((sum, item) => sum + item.file.size, 0) +
                    replacements.reduce(
                        (sum, file) => sum + file.files[0].size,
                        0
                    );

                if (
                    total > maxTotal ||
                    replacements.some(file => file.files[0].size > maxFile)
                ) {
                    event.preventDefault();
                    alert('Batas ukuran file terlampaui.');
                    return;
                }

                const data = new FormData(form);

                data.delete('newDocuments');
                data.delete('newDocumentNames');

                added.forEach(item => {
                    data.append('newDocuments', item.file, item.file.name);
                    data.append('newDocumentNames', item.name);
                });

                event.preventDefault();

                save.disabled = true;
                save.textContent = 'Menyimpan...';

                fetch(form.action, {
                    method: 'POST',
                    body: data,
                    redirect: 'follow'
                })
                .then(response => {
                    if (response.redirected) {
                        window.location.href = response.url;
                    } else {
                        return response.text().then(message => {
                            throw new Error(message || 'Gagal menyimpan perubahan.');
                        });
                    }
                })
                .catch(error => {
                    alert(error.message);

                    save.disabled = false;
                    save.textContent = 'Simpan Perubahan';
                });
            });
        })();
    </script>

</body>
</html>