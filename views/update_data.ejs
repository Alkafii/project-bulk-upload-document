<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Integration Documents</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <style>
        .upload-page {
            min-height: 100vh;
        }

        .upload-container {
            max-width: 1050px;
            width: 100%;
        }

        .dropzone {
            border: 2px dashed #9bb8df;
            border-radius: 12px;
            background: #f7faff;
            padding: 32px;
            text-align: center;
            cursor: pointer;
            transition: background-color .2s ease, border-color .2s ease;
        }

        .dropzone:hover,
        .dropzone.drag {
            background: #eaf2ff;
            border-color: #2563eb;
        }

        .dropzone:focus {
            outline: 3px solid rgba(37, 99, 235, .2);
            outline-offset: 2px;
        }

        .doc-row {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 14px;
            margin-bottom: 10px;
            background: #fff;
        }

        .upload-container {
            max-width: 100%;
        }

        @media (max-width: 768px) {
            .upload-page main {
                padding: 16px !important;
            }

            .upload-container {
                padding-left: 0;
                padding-right: 0;
            }
        }

        @media (max-width: 576px) {
            .upload-card-body {
                padding: 16px !important;
            }

            .dropzone {
                padding: 24px 14px;
            }

            .doc-row {
                padding: 12px;
            }

            .upload-actions {
                flex-wrap: wrap;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex upload-page">

        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4 w-100">
            <div class="container-fluid upload-container">
                <div class="sticky-top bg-light py-3 px-2 mb-2" style="z-index: 1020;">
                    <a href="/read_data?id=<%= integration.id %>" class="font-weight-bold">‹ Back</a>
                    <h3 class="text-primary font-weight-bold mt-3 mb-4">Edit Integration Documents</h3>
                </div>

                <%- include('./partials/alerts.ejs') %>

                <form id="editForm" action="/update_data?id=<%= integration.id %>" method="POST" enctype="multipart/form-data">
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-body p-4 upload-card-body">
                            <div class="form-row">
                                <div class="form-group col-md-6"> <label>Partner Name</label> <input class="form-control" name="institutionName" maxlength="256" value="<%= integration.name %>" required> </div>
                                <div class="form-group col-md-6"> <label>API Name</label> <input class="form-control" name="integrationType" maxlength="128" value="<%= integration.api_name %>" required> </div>
                            </div>
                        </div>
                    </div>
                    <div class="card border-0 shadow-sm mb-4">
                        <div class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0">
                            Current Documents (<%= totalDocuments %>)
                        </div>
                        <div class="card-body p-4 upload-card-body">

                            <div id="mainDocListContainer">
                                <%- documentsHTML %>
                            </div>

                            <nav class="mt-4">
                                <ul class="pagination pagination-sm justify-content-left mb-0" id="mainPaginationControls"></ul>
                            </nav>

                        </div>
                    </div>

                    <div class="card border-0 shadow-sm">
                        <h5 class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0 mb-1">Document List</h5>
                        <div class="card-body px-4 pb-4 pt-0 upload-card-body">
                            
                            <%- include('./partials/dropzone.ejs', {
                                dropzoneId: 'dropzone',
                                inputId: 'newInput'
                            }) %>

                            <div id="newList" class="mt-4"></div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end mt-4 upload-actions">
                        <a href="/read_data?id=<%= integration.id %>" class="btn btn-light mr-2">Cancel</a>
                        <button type="submit" id="saveBtn" class="btn btn-primary">Save</button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <div class="modal fade" id="reviewModal" tabindex="-1" role="dialog" aria-labelledby="reviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 10px;">
                <div class="modal-header">
                    <h5 class="modal-title font-weight-bold text-primary" id="reviewModalLabel">Review Data</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close" style="outline: none;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body py-3 d-flex flex-column" style="height: 530px;">
                    <table class="table table-sm table-borderless mb-3 flex-shrink-0">
                        <tr>
                            <td class="font-weight-bold p-0" style="width: 150px;">Partner Name</td>
                            <td class="p-0" style="width: 20px;">:</td>
                            <td class="p-0" id="reviewPartner"></td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold p-0">API Name</td>
                            <td class="p-0">:</td>
                            <td class="p-0" id="reviewApi"></td>
                        </tr>
                        <tr>
                            <td class="font-weight-bold p-0" style="width: 150px;">Total Size</td>
                            <td class="p-0" style="width: 20px;">:</td>
                            <td class="p-0" id="reviewSize"></td>
                        </tr>
                    </table>
                    
                    <h6 class="font-weight-bold text-secondary mt-2 mb-2 flex-shrink-0">Document to be uploaded:</h6>
                    <div class="card border rounded-lg flex-fill overflow-auto mb-3">
                        <ul class="list-group list-group-flush" id="reviewDocList"></ul>
                    </div>

                    <nav class="flex-shrink-0">
                        <ul class="pagination pagination-sm justify-content-center mb-0" id="reviewPaginationControls"></ul>
                    </nav>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light font-weight-bold text-secondary" data-dismiss="modal">Cancel</button>
                    <button type="button" id="confirmSubmitBtn" class="btn btn-primary font-weight-bold">Upload</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

    <script>
        (() => {
            "use strict";

            const form = document.getElementById('editForm'), input = document.getElementById('newInput');
            const drop = document.getElementById('dropzone'), list = document.getElementById('newList'), save = document.getElementById('saveBtn');

            const maxFile = Number('<%= maxMB * 1024 * 1024 %>'), maxTotal = Number('<%= maxTotalMB * 1024 * 1024 %>'), maxFiles = Number('<%= maxFiles %>');
            const allowed = ['pdf', 'doc', 'docx', 'xls', 'xlsx'];
            let added = [], currentMainPage = 1;
            const mainItemsPerPage = 10, $docItems = $('.main-doc-item');

            const fmt = n => (n / 1024 / 1024).toFixed(2) + ' MB';
            const nameOf = f => f.name.replace(/\.[^.]+$/, '').replace(/[_-]+/g, ' ').trim();
            const getAddedTotalSize = () => added.reduce((sum, item) => sum + item.file.size, 0);

            function render() {
                list.innerHTML = '';
                added.forEach((item, index) => {
                    const row = document.createElement('div');
                    row.className = 'doc-row';
                    row.innerHTML = `<label class="small font-weight-bold">Nama dokumen</label>
                        <div class="d-flex"><input class="form-control form-control-sm mr-2" maxlength="255" value="${item.name}"><button type="button" class="btn btn-sm btn-outline-danger">Hapus</button></div>
                        <div class="small text-muted mt-1">${item.file.name} · ${fmt(item.file.size)}</div>`;

                    row.querySelector('input').addEventListener('input', e => item.name = e.target.value);
                    row.querySelector('button').addEventListener('click', () => { added.splice(index, 1); render(); });
                    list.appendChild(row);
                });
            }

            function addFiles(files) {
                for (const file of Array.from(files || [])) {
                    const ext = file.name.split('.').pop().toLowerCase();
                    if (!allowed.includes(ext)) { alert('Format file tidak didukung: ' + file.name); continue; }
                    if (file.size > maxFile) { alert('Ukuran file terlalu besar: ' + file.name); continue; }
                    if (added.length >= maxFiles) { alert('Maksimal ' + maxFiles + ' file.'); break; }
                    if (getAddedTotalSize() + file.size > maxTotal) { alert('Total ukuran file melebihi batas.'); break; }

                    added.push({ file, name: nameOf(file) });
                }
                input.value = ''; render();
            }

            drop.addEventListener('click', () => input.click());
            input.addEventListener('change', () => addFiles(input.files));
            ['dragover', 'dragenter', 'dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, e => { e.preventDefault(); drop.classList.toggle('drag', ev.includes('er')); if (ev === 'drop') addFiles(e.dataTransfer.files); }));

            // Event Delegation Ringkas untuk Input File Replace (Menggantikan loop querySelectorAll lama)
            $(form).on('change', '.replacement-file', function() {
                const hidden = this.parentElement.querySelector('input[type="hidden"]');
                if (hidden) hidden.disabled = !this.files.length;
                const label = this.parentElement.querySelector('.custom-file-label');
                if (label) label.textContent = this.files.length ? this.files[0].name : "Choose file or drag here...";
            });

            form.addEventListener('submit', event => {
                event.preventDefault();
                const replacements = Array.from(document.querySelectorAll('.replacement-file')).filter(i => i.files.length);
                const deletes = Array.from(document.querySelectorAll('.delete-doc:checked')).map(c => c.value);

                if (replacements.some(f => deletes.includes(f.dataset.id))) return alert('Dokumen yang sama tidak bisa dihapus dan diganti sekaligus.');
                if (replacements.length + added.length > maxFiles) return alert('Maksimal ' + maxFiles + ' file perubahan per proses.');
                if (added.some(item => !item.name.trim())) return alert('Nama dokumen baru tidak boleh kosong.');

                const totalSize = getAddedTotalSize() + replacements.reduce((sum, f) => sum + f.files[0].size, 0);
                if (totalSize > maxTotal || replacements.some(f => f.files[0].size > maxFile)) return alert('Batas ukuran file terlampaui.');

                const data = new FormData(form);
                data.delete('newDocuments');
                data.delete('newDocumentNames');
                data.delete('replacementDocumentIds');

                for (const item of added) {
                    data.append("newDocuments", item.file, item.file.name);
                    data.append("newDocumentNames", item.name);
                }

                for (const fileInput of replacements) {
                    data.append(
                        "replacementDocumentIds",
                        fileInput.dataset.id
                    );
                }

                save.disabled = true;
                save.textContent = "Menyimpan...";

                fetch(form.action, {
                    method: "POST",
                    body: data,
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    }
                })
                .then(async function (response) {
                    const result = await response.json();

                    if (!response.ok) {
                        throw new Error(result.message || "Gagal menyimpan perubahan.");
                    }

                    if (result.success && result.redirectUrl) {
                        window.location.href = result.redirectUrl;
                        return;
                    }

                    throw new Error("Respons server tidak valid.");
                })
                .catch(function (err) {
                    alert(err.message);

                    save.disabled = false;
                    save.textContent = "Save";
                });
            });

            function renderMainPagePagination() {
                const totalMainItems = $docItems.length, totalPages = Math.ceil(totalMainItems / mainItemsPerPage), $controls = $('#mainPaginationControls').empty();
                if (totalMainItems === 0) return;

                $docItems.hide().slice((currentMainPage - 1) * mainItemsPerPage, currentMainPage * mainItemsPerPage).show();

                if (totalPages > 1) {
                    const createPageBtn = (label, targetPage, disabled, active) => {
                        return $(`<li class="page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}"><a class="page-link" href="#">${label}</a></li>`)
                            .on('click', e => { e.preventDefault(); if (!disabled) { currentMainPage = targetPage; renderMainPagePagination(); window.scrollTo({ top: 0, behavior: 'smooth' }); } });
                    };
                    $controls.append(createPageBtn('&laquo;', currentMainPage - 1, currentMainPage === 1));
                    for (let i = 1; i <= totalPages; i++) $controls.append(createPageBtn(i, i, false, currentMainPage === i));
                    $controls.append(createPageBtn('&raquo;', currentMainPage + 1, currentMainPage === totalPages));
                }
            }

            renderMainPagePagination();
        })();
    </script>

</body>
</html>