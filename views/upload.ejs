<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Upload Document</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
  <style>
    .upload-page {
      min-height: 100vh;
    }

    .upload-container {
      max-width: 1050px;
    }

    .dropzone {
      border: 2px dashed #9bb8df;
      border-radius: 12px;
      background: #f7faff;
      padding: 32px;
      text-align: center;
      cursor: pointer;
      transition: background-color .2s ease, border-color .2s ease;
    }

    .dropzone:hover,
    .dropzone.drag {
      background: #eaf2ff;
      border-color: #2563eb;
    }

    .dropzone:focus {
      outline: 3px solid rgba(37, 99, 235, .2);
      outline-offset: 2px;
    }

    .file-row {
      border: 1px solid #e2e8f0;
      border-radius: 9px;
      padding: 14px;
      margin-bottom: 10px;
      background: #fff;
    }

    .file-name {
      font-size: 13px;
      color: #64748b;
      word-break: break-word;
    }

    #fileCount {
      white-space: nowrap;
    }

    .upload-container {
      max-width: 100%;
    }

    @media (max-width: 768px) {
      .upload-page main {
        padding: 16px !important;
      }

      .upload-container {
        padding-left: 0;
        padding-right: 0;
      }
    }

    @media (max-width: 576px) {
      .upload-card-body {
        padding: 16px !important;
      }

      .dropzone {
        padding: 24px 14px;
      }

      .file-row {
        padding: 12px;
      }

      .file-row .d-flex {
        gap: 10px;
      }

      .file-row .remove-file {
        flex-shrink: 0;
      }

      .upload-actions {
        flex-wrap: wrap;
      }
    }
  </style>
</head>

<body class="bg-light">
  <div class="d-flex upload-page">

    <%- include('./partials/sidebar.ejs') %>

    <main class="flex-fill p-4 w-100">
      <div class="container-fluid upload-container">
        <div class="sticky-top bg-light py-3 px-2 mb-2" style="z-index: 1020;">
          <a href="/" class="font-weight-bold">‹ Back</a>
          <h3 class="text-primary font-weight-bold mt-3 mb-4">Upload Document</h3>
        </div>

        <div id="flashContainer">
            <%- include('./partials/alerts.ejs') %>
        </div>

        <form id="uploadForm" action="/upload" method="POST" enctype="multipart/form-data" class="card shadow-sm border-0" >
          <div class="card-body p-4 upload-card-body">
            <div class="form-group">
              <label for="institutionName">Partner Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="institutionName" name="institutionName" maxlength="256" placeholder="ex: Pemda Kota Bandung" autocomplete="organization" required >
            </div>
            <div class="form-group">
              <label for="integrationType">API Name <span class="text-danger">*</span></label>
              <input type="text" class="form-control" id="integrationType" name="integrationType" maxlength="128" placeholder="ex: Virtual Account SNAP Off Us" required >
            </div>

            <hr>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="font-weight-bold mb-0">Document List</h5>
                <span class="badge badge-primary" id="fileCount" aria-live="polite">0 Documents</span>
            </div>

            <%- include('./partials/dropzone.ejs', {
                dropzoneId: 'dropzone',
                inputId: 'fileInput'
            }) %>

            <div id="fileList" class="mt-4"></div>
            <%- include('./partials/document_list_item.ejs') %>

            <div class="d-flex justify-content-end mt-4 upload-actions">
                <a href="/" class="btn btn-light mr-2">Cancel</a>
                <button type="button" class="btn btn-primary" id="btnPreviewUpload">Upload</button>
            </div>
          </div>
        </form>
      </div>
    </main>
  </div>

  <%- include('./partials/modal_review_documents.ejs') %>

  <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

  <script>
    (() => {
      "use strict";

      const form = document.getElementById("uploadForm"), input = document.getElementById("fileInput");
      const drop = document.getElementById("dropzone"), list = document.getElementById("fileList");
      const count = document.getElementById("fileCount"), btnPreview = document.getElementById("btnPreviewUpload");
      const flashContainer = document.getElementById("flashContainer");
      const documentTemplate = document.getElementById("documentListItemTemplate");

      const maxFile = Number("<%= maxMB %>") * 1024 * 1024, maxTotal = Number("<%= maxTotalMB %>") * 1024 * 1024;
      const maxFiles = Number("<%= maxFiles %>"), allowed = ["pdf", "doc", "docx", "xls", "xlsx"];

      let selected = [], isUploading = false, currentModalPage = 1;
      const itemsPerPage = 10;

    function triggerFlashError(msg) {
      window.scrollTo({ top: 0, behavior: "smooth" });
      flashContainer.innerHTML = `<div class="alert alert-danger alert-dismissible text-center fade show shadow-sm w-100"><strong>${msg}</strong><button type="button" class="close" data-dismiss="alert">&times;</button></div>`;
    }

      const formatSize = (s) => s < 1048576
          ? (s / 1024).toFixed(1) + " KB"
          : (s / 1048576).toFixed(2) + " MB";

      const getTotalSize = () => selected.reduce(
          (total, item) => total + item.file.size,
          0
      );

      function render() {
        list.innerHTML = "";

        selected.forEach(function(item, index) {
            const row = documentTemplate.content.cloneNode(true);

            const label = row.querySelector("[data-document-label]");
            const nameInput = row.querySelector("[data-document-name]");
            const fileInfo = row.querySelector("[data-file-info]");
            const removeButton = row.querySelector("[data-remove-document]");

            label.textContent = "Document Name #" + (index + 1);

            nameInput.value = item.name;

            fileInfo.textContent =
                item.file.name + " · " + formatSize(item.file.size);

            nameInput.addEventListener("input", function() {
                item.name = this.value;
                checkDuplicates();
            });

            removeButton.addEventListener("click", function() {
                selected.splice(index, 1);
                render();
            });

            list.appendChild(row);
        });

        count.textContent =
            selected.length + " file · " + formatSize(getTotalSize());

        checkDuplicates();
    }

      function checkDuplicates() {
          btnPreview.disabled = selected.length === 0 || isUploading;
      }

      function addFiles(files) {
        if (isUploading) return;
        for (const file of Array.from(files || [])) {
          const ext = file.name.split('.').pop().toLowerCase();
          if (!allowed.includes(ext)) { triggerFlashError(`Format file tidak didukung! Gunakan ${allowed}`); continue; }
          if (file.size === 0) { triggerFlashError(`File kosong: ${file.name}`); continue; }
          if (file.size > maxFile) { triggerFlashError(`Batas maksimal ukuran per file adalah ${maxFile / 1048576} MB`); continue; }
          if (selected.length >= maxFiles) { triggerFlashError(`Maksimal ${maxFiles} file.`); break; }
          if (getTotalSize() + file.size > maxTotal) { triggerFlashError("Total ukuran seluruh file melebihi batas."); break; }

          selected.push({ file, name: file.name.replace(/\.[^.]+$/, "").replace(/[_-]+/g, " ").trim() });
        }
        render();
      }

      drop.addEventListener("click", () => !isUploading && input.click());
      input.addEventListener("change", () => addFiles(input.files));
      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.toggle("drag", ev.includes('over')); if (ev === 'drop' && !isUploading) addFiles(e.dataTransfer.files); }));

      function renderModalDocuments() {
        const docList = $('#reviewDocList').empty(), controls = $('#reviewPaginationControls').empty();
        const totalPages = Math.ceil(selected.length / itemsPerPage);
        const startIndex = (currentModalPage - 1) * itemsPerPage;
        
        selected.slice(startIndex, currentModalPage * itemsPerPage).forEach((item, index) => {
          const itemNumber = startIndex + index + 1;
          docList.append(`<li class="list-group-item d-flex align-items-center py-2">
                            <span class="text-muted mr-3 font-weight-bold" style="min-width: 25px;">${itemNumber}.</span>
                            <span class="text-primary mr-2">📄</span>
                            <span class="text-truncate font-weight-medium">${item.name.trim()}</span>
                          </li>`);
        });

        if (totalPages > 1) {
          const createPageBtn = (label, targetPage, disabled, active) => {
            return $(`<li class="page-item ${disabled ? 'disabled' : ''} ${active ? 'active' : ''}"><a class="page-link" href="#">${label}</a></li>`).on('click', (e) => { e.preventDefault(); if(!disabled) { currentModalPage = targetPage; renderModalDocuments(); } });
          };
          controls.append(createPageBtn('&laquo;', currentModalPage - 1, currentModalPage === 1));
          for (let i = 1; i <= totalPages; i++) controls.append(createPageBtn(i, i, false, currentModalPage === i));
          controls.append(createPageBtn('&raquo;', currentModalPage + 1, currentModalPage === totalPages));
        }
      }

      btnPreview.addEventListener("click", () => {
        if (!form.checkValidity()) { form.reportValidity(); return; }
        if (selected.length === 0) return;

        $('#reviewPartner').text($('#institutionName').val().trim());
        $('#reviewApi').text($('#integrationType').val().trim());
        $('#reviewSize').text((getTotalSize() / 1048576).toFixed(2) + " MB");
        $('#reviewDocCount').text(`${selected.length} Document${selected.length > 1 ? 's' : ''}`);

        currentModalPage = 1;
        renderModalDocuments();
        $('#reviewModal').modal('show');
      });

      document.getElementById("confirmSubmitBtn").addEventListener("click", async function() {
        const formData = new FormData(form);
        formData.delete("documents");
        selected.forEach(i => { formData.append("documents", i.file, i.file.name); formData.append("documentNames", i.name.trim()); });

        isUploading = true; this.disabled = true; this.textContent = "Uploading...";
        try {
            const res = await fetch(form.action, {
                method: "POST",
                body: formData,
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                }
            });

            const result = await res.json();

            if (!res.ok || !result.success) {
                throw new Error(result.message || "Upload gagal.");
            }

            window.location.assign(result.redirectUrl);

        } catch (err) {
            triggerFlashError(err.message || "Terjadi kesalahan sistem pengunggahan.");

            isUploading = false;
            this.disabled = false;
            this.textContent = "Upload";

            $('#reviewModal').modal('hide');
            render();
        }
      });

      render();
    })();
  </script>

</body>
</html>
