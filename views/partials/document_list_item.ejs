<link rel="stylesheet" href="/style/style.css">

<template id="documentListItemTemplate">
  <div class="file-row">
    <div class="row align-items-start no-gutters document-row-content">
      <div class="col-auto pr-3">
        <label class="font-weight-bold mb-0 text-dark document-name-label" data-document-label> Document Name #1
        </label>
      </div>
      <div class="col">
        <input type="text" class="form-control form-control-sm doc-name" maxlength="255" data-document-name required>
        <div class="file-name pl-1 mt-1" data-file-info> </div>
      </div>
      <div class="col-auto pl-4 delete-btn-wrapper">
        <button type="button" class="btn btn-sm btn-outline-danger remove-file" data-remove-document>Delete</button>
      </div>
    </div>
  </div>
</template>
