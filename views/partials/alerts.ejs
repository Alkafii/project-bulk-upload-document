<%
    let initialAlertMessage = "";
    let initialAlertType = "";

    if (typeof successMessage !== "undefined" && successMessage) {
        initialAlertMessage = successMessage;
        initialAlertType = "success";
    } else if (typeof errorMessage !== "undefined" && errorMessage) {
        initialAlertMessage = errorMessage;
        initialAlertType = "error";
    }
%>

<div class="py-2 px-0 w-100 overflow-visible">
    <div id="alertMessage" data-message="<%= initialAlertMessage %>" data-type="<%= initialAlertType %>" class="alert alert-dismissible fade show w-100 text-center mb-4 shadow-sm d-none" role="alert" aria-live="polite" >
        
        <strong id="alertText"></strong>

        <button type="button" class="close" id="closeAlert" aria-label="Close"></buttontype>
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
</div>