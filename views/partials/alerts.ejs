<div class="py-2 px-0 w-100 overflow-visible">
    <div id="alertMessage" class="alert alert-dismissible fade show w-100 text-center mb-4 shadow-sm d-none" role="alert" aria-live="polite" >
        <strong id="alertText"></strong>
        <buttontype="button"class="close"id="closeAlert"aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>

    <% if (typeof successMessage !== 'undefined' && successMessage) { %>
        <script>
            window.addEventListener("DOMContentLoaded", function() {
                showAlertMessage("<%= successMessage %>", "success");
            });
        </script>
    <% } %>

    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
        <script>
            window.addEventListener("DOMContentLoaded", function() {
                showAlertMessage("<%= errorMessage %>", "error");
            });
        </script>
    <% } %>
    
</div>