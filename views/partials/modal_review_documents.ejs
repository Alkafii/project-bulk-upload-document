<style>
    #reviewModal .modal-content {
        border: 0;
        border-radius: 16px;
        overflow: hidden;
        height: 680px;
        display: flex;
        flex-direction: column;
        background: #ffffff;
    }

    #reviewModal .modal-header {
        padding: 20px 24px;
        border-bottom: 1px solid #f1f5f9;
        flex-shrink: 0;
    }

    #reviewModal .modal-body {
        padding: 24px;
        display: flex;
        flex-direction: column;
        flex-grow: 1;
        overflow: hidden; 
    }

    /* BARU: Kontainer Utama Ringkasan Data Berbasis Grid Seimbang */
    #reviewModal .clean-summary-bar {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px 24px;
        margin-bottom: 24px;
        flex-shrink: 0;
    }

    /* MENYINKRONKAN: Memaksa baris kolom Bootstrap selalu lurus sejajar rata atas */
    #reviewModal .clean-summary-bar .row {
        display: flex;
        flex-wrap: wrap;
        align-items: start;
    }

    /* MENYINKRONKAN: Mengubah arah aliran item agar ditarik lurus ke atas */
    #reviewModal .summary-item {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

    #reviewModal .summary-label {
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 5px;
    }

    #reviewModal .summary-value {
        color: #0f172a;
        font-weight: 700;
        font-size: 14px;
        overflow-wrap: anywhere;
        line-height: 1.4;
    }

    /* Nilai angka statistik utama */
    #reviewModal .summary-value.stat-highlight {
        color: #1d4ed8;
        font-size: 14px; /* Disamakan 14px agar tingginya presisi horizontal dengan kolom nama */
    }

    /* Ornamen pembatas vertikal tipis khusus antar kolom Bootstrap agar elegan */
    #reviewModal .summary-col-divider {
        border-right: 1px solid #e2e8f0;
        padding-bottom: 4px; /* Penyesuaian jarak ruang bawah agar presisi */
    }

    #reviewModal .review-list-wrapper {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        flex-grow: 1;
        overflow-y: auto;
        background: #fff;
        margin-bottom: 0;
    }

    #reviewModal .review-list {
        margin-bottom: 0;
    }

    #reviewModal .review-item {
        display: flex;
        align-items: flex-start;
        padding: 12px 15px;
        border-bottom: 1px solid #edf0f4;
        background: #fff;
    }

    #reviewModal .review-item:last-child {
        border-bottom: 0;
    }

    #reviewModal .review-number {
        width: 27px;
        height: 27px;
        min-width: 27px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        background: #edf4ff;
        color: #2563eb;
        font-size: 12px;
        font-weight: 700;
        margin-right: 12px;
    }

    #reviewModal .review-document-name {
        font-size: 14px;
        font-weight: 700;
        color: #26364a;
        overflow-wrap: anywhere;
    }

    #reviewModal .review-file-name {
        font-size: 12px;
        color: #718096;
        overflow-wrap: anywhere;
        margin-top: 3px;
    }

    #reviewModal .review-item-meta {
        font-size: 11px;
        color: #718096;
        margin-top: 5px;
    }

    #reviewModal .review-type {
        display: inline-block;
        font-size: 10px;
        font-weight: 700;
        padding: 4px 8px;
        border-radius: 20px;
        background: #edf4ff;
        color: #2563eb;
        white-space: nowrap;
    }

    #reviewModal .review-type.replacement {
        background: #fff5e8;
        color: #b7791f;
    }

    #reviewModal .review-pagination {
        padding-top: 14px;
        padding-bottom: 2px;
        flex-shrink: 0;
    }

    #reviewModal .modal-footer {
        padding: 15px 24px;
        border-top: 1px solid #f1f5f9;
        flex-shrink: 0;
        background: #fff;
    }

    @media (max-width: 768px) {
        #reviewModal .summary-col-divider {
            border-right: 0;
            border-bottom: 1px dashed #e2e8f0;
            padding-bottom: 10px;
            margin-bottom: 10px;
        }
    }

    @media (max-width: 576px) {
        #reviewModal .modal-dialog {
            margin: 10px;
        }

        #reviewModal .modal-content {
            height: auto;
            max-height: 90vh;
        }

        #reviewModal .modal-header {
            padding: 16px;
        }

        #reviewModal .modal-body {
            padding: 16px;
        }

        #reviewModal .modal-footer {
            padding: 12px 16px;
        }

        #reviewModal .review-item {
            padding: 11px;
        }
    }
</style>

<div class="modal fade" id="reviewModal"
     tabindex="-1" role="dialog"
     aria-labelledby="reviewModalLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content shadow-lg">

            <div class="modal-header">
                <div>
                    <h5 class="modal-title font-weight-bold text-primary mb-1"
                        id="reviewModalLabel">
                        Upload Confirmation
                    </h5>

                    <small class="text-muted">
                        Review the document before saving changes.
                    </small>
                </div>

                <button type="button" class="close"
                        data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>

            <div class="modal-body">

                <div class="clean-summary-bar">
                    <!-- Menambahkan class align-items-start langsung pada pembungkus baris Bootstrap -->
                    <div class="row align-items-start">
                        
                        <!-- Kolom 1 (col-md-3) -->
                        <div class="col-md-3 summary-col-divider">
                            <div class="summary-item">
                                <span class="summary-label">Partner Name</span>
                                <span class="summary-value" id="reviewPartner">-</span>
                            </div>
                        </div>
                        
                        <!-- Kolom 2 (col-md-3) -->
                        <div class="col-md-3 summary-col-divider">
                            <div class="summary-item pl-0 pl-md-2">
                                <span class="summary-label">API Name</span>
                                <span class="summary-value" id="reviewApi">-</span>
                            </div>
                        </div>

                        <!-- Kolom 3 (col-md-3) -->
                        <div class="col-md-3 summary-col-divider">
                            <div class="summary-item pl-0 pl-md-2">
                                <span class="summary-label">Total Document</span>
                                <span class="summary-value stat-highlight" id="reviewDocCount">0</span>
                            </div>
                        </div>

                        <!-- Kolom 4 (col-md-3) -->
                        <div class="col-md-3">
                            <div class="summary-item pl-0 pl-md-2">
                                <span class="summary-label">Total Size</span>
                                <span class="summary-value stat-highlight" id="reviewSize">0 MB</span>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2 flex-shrink-0">
                    <h6 class="font-weight-bold mb-0">
                        Document List
                    </h6>

                    <small class="text-muted" id="reviewPageInfo"></small>
                </div>

                <!-- Kontainer Daftar Dokumen -->
                <div class="review-list-wrapper">
                    <ul class="list-unstyled review-list" id="reviewDocList">
                    </ul>
                </div>

                <!-- Kontainer Kontrol Navigasi Pagination -->
                <nav class="review-pagination" id="reviewPaginationContainer">
                    <ul class="pagination pagination-sm justify-content-left mb-0"
                        id="reviewPaginationControls">
                    </ul>
                </nav>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-light font-weight-bold text-secondary"
                        data-dismiss="modal">
                    Cancel
                </button>

                <button type="button"
                        id="confirmSubmitBtn"
                        class="btn btn-primary font-weight-bold px-4">
                    Upload
                </button>
            </div>
        </div>
    </div>
</div>
