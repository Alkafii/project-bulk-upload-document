<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Bootstrap 4</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    
    <style>
        html, body {
            height: 100%;
        }
        body {
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #f5f5f5;
        }
        .form-login {
            width: 100%;
            max-width: 400px;
            padding: 15px;
            margin: auto;
            border-radius: 8px;
        }
    </style>

</head>
<body>
    <div class="card shadow-sm form-login">
        <div class="card-body">
            <h3 class="card-title text-center mb-4">Please Login</h3>
            <form action="/login" method="POST">
                <div class="form-group">
                    <label for="exampleFormControlInput">Username</label>
                    <input type="text" name="username" class="form-control" id="exampleFormControlInput" placeholder="example" required>
                </div>
                <div class="form-group">
                    <label for="exampleFormControlPassword">Password</label>
                    <input type="password" name="password" class="form-control" id="exampleFormControlPassword" placeholder="example" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block py-2">Sign In</button>
            </form>
            <p class="mt-4 mb-0 text-muted text-center">&copy; 2017–2026</p>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>

</body>
</html>
