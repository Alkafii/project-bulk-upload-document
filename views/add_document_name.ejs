<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Document Name</title>
    <link rel="stylesheet" href="/style/style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
</head>

<body>
    <div class="app-layout">

        <%- include('./partials/sidebar.ejs') %>

        <main class="app-content page-content">
            <div class="container-fluid px-0">
                <div class="mb-4">
                    <h3 class="page-title text-uppercase mb-2">Add Document Name</h3>
                    <p class="text-muted mb-0">Manage the list of document names required for the API integration process.</p>
                </div>
                <div class="card document-card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h6 class="section-title mb-3">
                            <span class="mr-2">＋</span>
                            Add New Document
                        </h6>
                        <hr>
                        <% if (message) { %>
                            <div class="alert alert-success alert-dismissible fade show">
                                <%= message %>
                                <button type="button" class="close" data-dismiss="alert">
                                    <span>&times;</span>
                                </button>
                            </div>
                        <% } %>

                        <% if (errorMessage) { %>
                            <div class="alert alert-danger alert-dismissible fade show">
                                <%= errorMessage %>

                                <button type="button" class="close" data-dismiss="alert">
                                    <span>&times;</span>
                                </button>
                            </div>
                        <% } %>
                        <form id="documentForm" action="/document_names" method="post">
                            <div class="form-group mb-4">
                                <label class="form-label">
                                    Document Category<span class="required">*</span>
                                </label>
                                <select class="form-control" id="documentCategory" name="category" required>
                                    <option value="" selected disabled>Select document category</option>

                                    <%- documentCategory %>

                                </select>
                                <small class="form-text text-muted">Select the category where the document will be added.</small>
                            </div>
                            <div class="form-group mb-1">
                                <label class="form-label">
                                    Document Name<span class="required">*</span>
                                </label>
                                <input type="text" class="form-control" id="documentName" name="documentName" placeholder="Example: Form Pendaftaran API" maxlength="150" required>
                                <small class="form-text text-muted">Enter the document name to be used as the upload field identity.</small>
                            </div>
                            <div class="d-flex justify-content-end">
                                <button type="reset" class="btn btn-light text-secondary mr-2">Reset</button>
                                <button type="submit" class="btn btn-primary">Save</button>
                            </div>                            
                        </form>
                    </div>
                </div>

                <div class="card document-card shadow-sm">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="section-title mb-0">Registered Documents</h6>
                            <span class="badge badge-primary">Document Management</span>
                        </div>
                        <hr>
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover document-table mb-0">
                                <thead>
                                    <tr>
                                        <th width="7%" class="text-center">No</th>
                                        <th width="30%">Category</th>
                                        <th>Document Name</th>
                                        <th width="15%" class="text-center">Action</th>
                                    </tr>
                                </thead>
                                <tbody>

                                    <% if (typeof documentGroups !== 'undefined' && documentGroups.length > 0) { %>
                                        <% let number = 1; %>
                                        <% documentGroups.forEach(group => { %>
                                            <% group.documents.forEach(document => { %>
                                                <tr>
                                                    <td class="text-center"><%= number++ %></td>
                                                    <td><%= group.name %></td>
                                                    <td><%= document.name %></td>
                                                    <td class="text-center">
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle="modal" data-target="#modalEditDocument" data-category="<%= group.name %>" data-name="<%= document.name %>">
                                                            Edit
                                                        </button>
                                                        <form action="/document_names/delete" method="POST" class="d-inline">
                                                            <input type="hidden" name="category" value="<%= group.name %>">
                                                            <input type="hidden" name="documentName" value="<%= document.name %>">
                                                                <button type="button" class="btn btn-sm btn-outline-danger btn-trigger-delete" data-toggle="modal" data-target="#modalDeleteConfirmation" data-category="<%= group.name %>" data-document="<%= document.name %>">
                                                                    Delete
                                                                </button>
                                                        </form>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        <% }) %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="4" class="text-center text-muted py-4">
                                                Document list will appear here.
                                            </td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <!-- Modal Konfirmasi Delete Berkas -->
    <div class="modal fade" id="modalDeleteConfirmation" tabindex="-1" role="dialog" aria-labelledby="labelDeleteConfirmation" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <form action="/document_names/delete" method="POST" class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="labelDeleteConfirmation">Confirm to delete this document</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="category" id="modal-delete-category">
                    <input type="hidden" name="documentName" id="modal-delete-document">Are you sure you want to delete the integration document "<strong id="nama-berkas-modal"></strong>"?
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete</button>
                </div>
            </form>
        </div>
    </div>


    <div class="modal fade" id="modalEditDocument" tabindex="-1" role="dialog" aria-labelledby="labelEditDocument" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" role="document">
            <form action="/document_names/update"method="POST"class="modal-content"id="formEditDocument">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title" id="labelEditDocument">Edit Document Name</h5>
                        <small class="text-muted">Update the registered document name.</small>
                    </div>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="editDocumentCategory">Document Category</label>
                        <input type="text" class="form-control" id="editDocumentCategory" readonly />
                        <input type="hidden" name="category" id="editCategory" />
                    </div>
                    <div class="form-group mb-2">
                        <label for="editDocumentName"> Document Name <span class="text-danger">*</span> </label>
                        <input type="text" class="form-control" id="editDocumentName" name="newDocumentName" placeholder="Enter document name" maxlength="150" required />
                        <input type="hidden" name="oldDocumentName" id="oldDocumentName" />
                        <small class="form-text text-muted">
                            Document name maximum 150 characters.
                        </small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light text-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" id="btnSaveEditDocument"> Save </button>
                </div>
            </form>
        </div>
    </div>


    <script src="https://code.jquery.com/jquery-3.4.1.slim.min.js" integrity="sha384-J6qa4849blE2+poT4WnyKhv5vZF5SrPo0iEjwBvKU7imGFAV0wwj1yYfoRSJoZ+n" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
    <script>
        $(document).ready(function () {
            $('#modalEditDocument').on('show.bs.modal', function (event) {
                const button = $(event.relatedTarget);
                const category = button.data('category');
                const documentName = button.data('name');

                $('#editDocumentCategory').val(category);
                $('#editCategory').val(category);

                $('#editDocumentName').val(documentName);
                $('#oldDocumentName').val(documentName);

            });


            $('#modalEditDocument').on('shown.bs.modal', function () {
                $('#editDocumentName').trigger('focus');
            });


            $('#formEditDocument').on('submit', function (event) {
                const oldName = $('#oldDocumentName').val().trim();
                const newName = $('#editDocumentName').val().trim();

                if (!newName) {
                    event.preventDefault();
                    alert('Nama dokumen tidak boleh kosong.');
                    $('#editDocumentName').trigger('focus');
                    return false;
                }

                if (newName.length > 150) {
                    event.preventDefault();
                    alert('Nama dokumen maksimal 150 karakter.');
                    return false;
                }

                if (newName === oldName) {
                    event.preventDefault();
                    $('#modalEditDocument').modal('hide');
                    return false;
                }

                return true;
            });


            $('.btn-trigger-delete').on('click', function () {

                const category = $(this).data('category');
                const documentName = $(this).data('document');

                $('#nama-berkas-modal').text(documentName);

                $('#modal-delete-category').val(category);
                $('#modal-delete-document').val(documentName);

            });
        });
    </script>
</body>
</html>