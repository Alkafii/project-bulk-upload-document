<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Detail Integration</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        .upload-page {
            min-height: 100vh;
        }

        .upload-container {
            max-width: 1050px;
            width: 100%; 
        }

        .upload-container {
            max-width: 100%;
        }

        @media (max-width: 768px) {
            .upload-page main {
                padding: 16px !important;
            }
            .upload-container {
                padding-left: 0;
                padding-right: 0;
            }
        }

        @media (max-width: 576px) {
            .upload-card-body {
                padding: 16px !important;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex upload-page">

        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4 w-100">
            <div class="container-fluid upload-container">
                <a href="/" class="font-weight-bold">‹ Back</a>

                <div class="d-flex justify-content-between align-items-center mt-3 mb-4">
                    <h3 class="text-primary font-weight-bold mb-0">Detail Integration</h3>
                    <a
                        class="btn btn-primary"
                        href="/update_data?id=<%= integration.id %>">
                        Edit
                    </a>
                </div>

                <% if (typeof message !== "undefined" && message) { %>
                    <div class="alert alert-success"><%= message %></div>
                <% } %>

                <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
                    <div class="alert alert-danger"><%= errorMessage %></div>
                <% } %>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 upload-card-body">
                        <div class="row">
                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">Partner</small>
                                <div class="font-weight-bold">
                                    <%= integration.name %>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">API Name</small>
                                <div class="font-weight-bold">
                                    <%= integration.api_name %>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">Total</small>
                                <div class="font-weight-bold">
                                    <%= documents.length %> Documents
                                </div>
                            </div>

                            <div class="col-md-3">
                                <small class="text-muted">Total Size</small>
                                <div class="font-weight-bold">
                                    <%= totalSize %> MB
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0">
                        Uploaded Documents
                    </div>

                    <div class="card-body p-4 upload-card-body">
                        <% if (!documents.length) { %>
                            <div class="text-muted text-center py-4">
                                Belum ada dokumen.
                            </div>
                        <% } %>

                        <% documents.forEach((doc, index) => { %>
                            <div class="d-flex flex-wrap justify-content-between align-items-center <%= index !== documents.length - 1 ? 'border-bottom pb-3 mb-3' : '' %>">
                                <div class="pr-3">
                                    <div class="font-weight-bold">
                                        <%= doc.document_name %>
                                    </div>
                                    <small class="text-muted">
                                        <%= doc.original_filename %>
                                        ·
                                        <%= (Number(doc.file_size) / 1024 / 1024).toFixed(2) %>
                                        MB
                                    </small>
                                </div>
                                <a class="btn btn-sm btn-outline-primary" href="/view_file?documentId=<%= doc.id %>"> View </a>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>
