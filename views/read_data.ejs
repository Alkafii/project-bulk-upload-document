<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Detail Integration</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        .upload-page {
            min-height: 100vh;
        }

        .upload-container {
            max-width: 1050px;
            width: 100%; 
        }

        .upload-container {
            max-width: 100%;
        }

        @media (max-width: 768px) {
            .upload-page main {
                padding: 16px !important;
            }
            .upload-container {
                padding-left: 0;
                padding-right: 0;
            }
        }

        @media (max-width: 576px) {
            .upload-card-body {
                padding: 16px !important;
            }
        }
    </style>
</head>
<body class="bg-light">
    <div class="d-flex upload-page">

        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4 w-100">
            <div class="container-fluid upload-container">
                <div class="sticky-top bg-light py-3 px-2 mb-4" style="z-index: 1020">
                    <a href="/" class="font-weight-bold">‹ Back</a>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <h3 class="text-primary font-weight-bold mb-0">Detail Integration</h3>
                        <a class="btn btn-primary" href="/update_data?id=<%= integration.id %>">
                            Edit
                        </a>
                    </div>
                </div>

                <% if (typeof message !== "undefined" && message) { %>
                    <div class="alert alert-success"><%= message %></div>
                <% } %>

                <% if (typeof errorMessage !== "undefined" && errorMessage) { %>
                    <div class="alert alert-danger"><%= errorMessage %></div>
                <% } %>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 upload-card-body">
                        <div class="row">
                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">Partner</small>
                                <div class="font-weight-bold">
                                    <%= integration.name %>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">API Name</small>
                                <div class="font-weight-bold">
                                    <%= integration.api_name %>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">Total</small>
                                <div class="font-weight-bold">
                                    <%= documents.length %> Documents
                                </div>
                            </div>

                            <div class="col-md-3">
                                <small class="text-muted">Total Size</small>
                                <div class="font-weight-bold">
                                    <%= totalSize %> MB
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0">
                        Uploaded Documents
                    </div>

                    <div class="card-body p-4 upload-card-body">
                        <% if (!documents.length) { %>
                            <div class="text-muted text-center py-4">
                                Belum ada dokumen.
                            </div>
                        <% } %>

                        <% documents.forEach((doc, index) => { %>
                            <div class="main-doc-item d-flex flex-wrap justify-content-between align-items-start <%= index !== documents.length - 1 ? 'border-bottom pb-3 mb-3' : '' %>">
                                <div class="d-flex pr-3">
                                    <div class="font-weight-bold text-muted mr-3" style="min-width: 25px;">
                                        <%= index + 1 %>.
                                    </div>

                                    <div>
                                        <div class="font-weight-bold">
                                            <%= doc.document_name %>
                                        </div>

                                        <small class="text-muted">
                                            <%= doc.original_filename %>
                                            ·
                                            <%= (Number(doc.file_size) / 1024 / 1024).toFixed(2) %> MB
                                        </small>
                                    </div>
                                </div>

                                <div class="pt-1">
                                    <a class="btn btn-sm btn-outline-primary"
                                    href="/view_file?documentId=<%= doc.id %>">
                                        View
                                    </a>
                                </div>
                            </div>
                        <% }) %>

                        <nav class="mt-4" aria-label="Document pagination">
                            <ul class="pagination pagination-sm justify-content-center mb-0"
                                id="documentPaginationControls">
                            </ul>
                        </nav>

                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        (() => {
            "use strict";

            let currentPage = 1;

            const itemsPerPage = 10;
            const docItems = document.querySelectorAll(".main-doc-item");
            const paginationControls = document.getElementById("documentPaginationControls");

            function renderPagination() {
                const totalItems = docItems.length;
                const totalPages = Math.ceil(totalItems / itemsPerPage);

                paginationControls.innerHTML = "";

                if (totalItems === 0) return;

                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;

                // Sembunyikan seluruh dokumen terlebih dahulu
                docItems.forEach(item => {
                    item.style.display = "none";
                });

                // Tampilkan maksimal 10 dokumen sesuai halaman
                Array.from(docItems)
                    .slice(startIndex, endIndex)
                    .forEach(item => {
                        item.style.display = "";
                    });

                // Tidak perlu pagination jika hanya ada satu halaman
                if (totalPages <= 1) return;

                function createPageButton(label, targetPage, disabled = false, active = false) {
                    const li = document.createElement("li");

                    li.className = `page-item ${disabled ? "disabled" : ""} ${active ? "active" : ""}`;

                    const link = document.createElement("a");
                    link.className = "page-link";
                    link.href = "#";
                    link.innerHTML = label;

                    link.addEventListener("click", function (e) {
                        e.preventDefault();

                        if (disabled) return;

                        currentPage = targetPage;

                        renderPagination();

                        window.scrollTo({
                            top: 0,
                            behavior: "smooth"
                        });
                    });

                    li.appendChild(link);

                    return li;
                }

                // Tombol Previous
                paginationControls.appendChild(
                    createPageButton(
                        "&laquo;",
                        currentPage - 1,
                        currentPage === 1
                    )
                );

                // Nomor halaman
                for (let i = 1; i <= totalPages; i++) {
                    paginationControls.appendChild(
                        createPageButton(
                            i,
                            i,
                            false,
                            currentPage === i
                        )
                    );
                }

                // Tombol Next
                paginationControls.appendChild(
                    createPageButton(
                        "&raquo;",
                        currentPage + 1,
                        currentPage === totalPages
                    )
                );
            }

            // Jalankan pagination saat halaman pertama kali dibuka
            renderPagination();

        })();
    </script>
</body>
</html>
