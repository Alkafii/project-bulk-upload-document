<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Detail Integrasi</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
</head>
<body class="bg-light">
    <div class="d-flex" style="min-height: 100vh">
        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4">
            <div class="container-fluid" style="max-width: 1100px">
                <a href="/" class="font-weight-bold">‹ Back</a>

                <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                    <h3 class="text-primary font-weight-bold mb-0">
                        Detail Integrasi
                    </h3>

                    <a
                        class="btn btn-primary"
                        href="/update_data?id=<%= integration.id %>">
                        Edit
                    </a>
                </div>

                <% if (message) { %>
                    <div class="alert alert-success"><%= message %></div>
                <% } %>

                <% if (errorMessage) { %>
                    <div class="alert alert-danger"><%= errorMessage %></div>
                <% } %>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-4">
                                <small class="text-muted">Mitra / Institusi</small>
                                <div class="font-weight-bold">
                                    <%= integration.name %>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <small class="text-muted">API Name</small>
                                <div class="font-weight-bold">
                                    <%= integration.api_name %>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <small class="text-muted">VA Type</small>
                                <div class="font-weight-bold">
                                    <%= integration.va_type || '-' %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white font-weight-bold">
                        Dokumen Terunggah (<%= documents.length %>)
                    </div>

                    <div class="card-body">
                        <% if (!documents.length) { %>
                            <div class="text-muted text-center py-4">
                                Belum ada dokumen.
                            </div>
                        <% } %>

                        <% documents.forEach(doc => { %>
                            <div class="d-flex flex-wrap justify-content-between align-items-center border-bottom py-3">
                                <div class="pr-3">
                                    <div class="font-weight-bold">
                                        <%= doc.document_name %>
                                    </div>

                                    <small class="text-muted">
                                        <%= doc.original_filename %>
                                        ·
                                        <%= (Number(doc.file_size) / 1024 / 1024).toFixed(2) %>
                                        MB
                                    </small>
                                </div>

                                <a
                                    class="btn btn-sm btn-outline-primary"
                                    href="/view_file?documentId=<%= doc.id %>">
                                    Lihat / Unduh
                                </a>
                            </div>
                        <% }) %>
                    </div>
                </div>
            </div>
        </main>
    </div>
</body>
</html>