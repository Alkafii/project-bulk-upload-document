<!doctype html>
<html lang="id">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Detail Integration Documents</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="/style/style.css">
</head>
<body class="bg-light">
    <div class="d-flex upload-page">

        <%- include('./partials/sidebar.ejs') %>

        <main class="flex-fill p-4 w-100">
            <div class="container-fluid upload-container">
                <div class="sticky-top bg-light py-3 px-2 mb-4" style="z-index: 1020">
                    <a href="/" class="font-weight-bold">‹ Back</a>
                    <div class="d-flex justify-content-between align-items-center mt-3">
                        <h3 class="text-primary font-weight-bold mb-0">Detail Integration Documents</h3>
                        <a class="btn btn-primary" href="/update_data?id=<%= integration.id %>">
                            Edit
                        </a>
                    </div>
                </div>

                <%- include('./partials/alerts.ejs') %>

                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-body p-4 upload-card-body">
                        <div class="row">
                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">Partner</small>
                                <div class="font-weight-bold">
                                    <%= integration.name %>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">API Name</small>
                                <div class="font-weight-bold">
                                    <%= integration.api_name %>
                                </div>
                            </div>

                            <div class="col-md-3 mb-3 mb-md-0">
                                <small class="text-muted">Total</small>
                                <div class="font-weight-bold blue-muted">
                                    <%= totalDocuments %> Documents
                                </div>
                            </div>

                            <div class="col-md-3">
                                <small class="text-muted">Total Size</small>
                                <div class="font-weight-bold blue-muted">
                                    <%= totalSize %> MB
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-0 shadow-sm">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white font-weight-bold pt-4 px-4 border-0 pb-0">
                            Uploaded Documents
                        </div>
                        <div class="card-body p-4 upload-card-body">
                            <%- documentsHTML %>
                            <%- paginationHTML %>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <script>
        (() => {
            "use strict";

            const ITEMS_PER_PAGE = 10;

            let currentPage = 1;

            const docItems = Array.from(
                document.querySelectorAll(".main-doc-item")
            );

            const paginationControls = document.getElementById(
                "documentPaginationControls"
            );

            function createPageButton(label, targetPage, disabled = false, active = false) {
                const li = document.createElement("li");

                li.className = `page-item ${disabled ? "disabled" : ""} ${active ? "active" : ""}`;

                const link = document.createElement("a");
                link.className = "page-link";
                link.href = "#";
                link.innerHTML = label;

                link.addEventListener("click", function (e) {
                    e.preventDefault();

                    if (disabled || targetPage < 1) return;

                    currentPage = targetPage;

                    renderPagination();

                    window.scrollTo({
                        top: 0,
                        behavior: "smooth"
                    });
                });

                li.appendChild(link);

                return li;
            }

            function renderPagination() {
                const totalItems = docItems.length;
                const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);

                paginationControls.innerHTML = "";

                if (totalItems === 0) return;

                currentPage = Math.min(Math.max(currentPage, 1), totalPages);

                const startIndex = (currentPage - 1) * ITEMS_PER_PAGE;
                const endIndex = startIndex + ITEMS_PER_PAGE;

                docItems.forEach((item, index) => {
                    const isVisible = index >= startIndex && index < endIndex;

                    item.classList.toggle(
                        "pagination-hidden",
                        !isVisible
                    );
                });

                if (totalPages <= 1) return;

                paginationControls.appendChild(
                    createPageButton(
                        "&laquo;",
                        currentPage - 1,
                        currentPage === 1
                    )
                );

                for (let page = 1; page <= totalPages; page++) {
                    paginationControls.appendChild(
                        createPageButton(
                            page,
                            page,
                            false,
                            currentPage === page
                        )
                    );
                }

                paginationControls.appendChild(
                    createPageButton(
                        "&raquo;",
                        currentPage + 1,
                        currentPage === totalPages
                    )
                );
            }

            renderPagination();

        })();
    </script>

</body>
</html>
